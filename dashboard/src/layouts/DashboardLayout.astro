---
interface Props {
  title: string;
  activeNav?: 'overview' | 'devices' | 'content' | 'playlists' | 'store-wall' | 'telemetry' | 'settings' | 'sku-roadmap';
}

const { title, activeNav = 'overview' } = Astro.props;
---

<!doctype html>
<html lang="pt" translate="no" data-theme="dark" class="dark notranslate">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Invision Nexus — Fnac & Darty</title>
    <style is:global>
      /* ===================================================================== */
      /* TEMA DIA / NOITE (LIGHT & DARK MODE ENGINE — AUTO / MANUAL)           */
      /* ===================================================================== */
      html[data-theme='light'] body {
        background-color: #f1f5f9 !important;
        color: #0f172a !important;
      }

      /* Superfícies e Cartões no Modo Dia (Inspirado no Bizcastz Clean Light) */
      html[data-theme='light'] .bg-slate-950,
      html[data-theme='light'] .bg-slate-950\/90,
      html[data-theme='light'] .bg-slate-950\/60,
      html[data-theme='light'] .bg-slate-950\/50,
      html[data-theme='light'] .bg-slate-950\/40 {
        background-color: #f8fafc !important;
      }

      html[data-theme='light'] .bg-slate-900,
      html[data-theme='light'] .bg-slate-900\/90,
      html[data-theme='light'] .bg-slate-900\/70,
      html[data-theme='light'] .bg-slate-900\/60 {
        background-color: #ffffff !important;
        box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.04);
      }

      html[data-theme='light'] .bg-slate-800 {
        background-color: #e2e8f0 !important;
      }

      html[data-theme='light'] .hover\:bg-slate-800:hover,
      html[data-theme='light'] .hover\:bg-slate-800\/60:hover,
      html[data-theme='light'] .hover\:bg-slate-800\/50:hover {
        background-color: #f1f5f9 !important;
      }

      /* Bordas e Divisores no Modo Dia */
      html[data-theme='light'] .border-slate-800,
      html[data-theme='light'] .border-slate-800\/80,
      html[data-theme='light'] .border-slate-900 {
        border-color: #e2e8f0 !important;
      }

      html[data-theme='light'] .border-slate-700 {
        border-color: #cbd5e1 !important;
      }

      html[data-theme='light'] .divide-slate-800\/70 > :not([hidden]) ~ :not([hidden]) {
        border-color: #e2e8f0 !important;
      }

      /* Tipografia e Contraste no Modo Dia */
      html[data-theme='light'] .text-white,
      html[data-theme='light'] .text-slate-100,
      html[data-theme='light'] .text-slate-200 {
        color: #0f172a !important;
      }

      html[data-theme='light'] .text-slate-300 {
        color: #334155 !important;
      }

      html[data-theme='light'] .text-slate-400,
      html[data-theme='light'] .text-slate-500 {
        color: #64748b !important;
      }

      /* Cores de Acento Mais Legíveis sobre Fundo Claro */
      html[data-theme='light'] .text-amber-300,
      html[data-theme='light'] .text-amber-400 {
        color: #b45309 !important;
      }

      html[data-theme='light'] .text-emerald-300,
      html[data-theme='light'] .text-emerald-400 {
        color: #047857 !important;
      }

      html[data-theme='light'] .text-sky-300,
      html[data-theme='light'] .text-sky-400 {
        color: #0369a1 !important;
      }

      html[data-theme='light'] .text-purple-300,
      html[data-theme='light'] .text-purple-400 {
        color: #6d28d9 !important;
      }

      html[data-theme='light'] .text-indigo-300 {
        color: #4338ca !important;
      }

      html[data-theme='light'] .text-rose-300,
      html[data-theme='light'] .text-rose-400 {
        color: #be123c !important;
      }

      /* Preserva texto branco em badges vermelhos Darty */
      html[data-theme='light'] .bg-\[\#E30613\].text-white {
        color: #ffffff !important;
      }
    </style>
  </head>
  <body
    id="app-body"
    data-brand="FNAC"
    data-role="GLOBAL_ADMIN"
    class="bg-slate-950 text-slate-100 min-h-screen flex antialiased selection:bg-amber-500 selection:text-black"
  >
    <!-- SIDEBAR DE NAVEGAÇÃO COM BRAND SWITCHER GLOBAL & SIMULADOR RBAC -->
    <aside class="w-72 bg-slate-900/90 border-r border-slate-800 flex flex-col justify-between shrink-0">
      <div>
        <!-- Brand Header -->
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div
              id="brand-badge"
              class="w-10 h-10 rounded-lg bg-[#E1A924] text-black font-black flex items-center justify-center text-lg shadow-lg transition-colors"
            >
              FN
            </div>
            <div>
              <h1 class="font-bold text-base tracking-tight text-white">INVISION NEXUS</h1>
              <p id="brand-subtitle" class="text-xs text-amber-400 font-medium">
                Contexto Isolado: FNAC
              </p>
            </div>
          </div>
          <span class="px-2 py-0.5 text-[10px] font-mono uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded">
            v1.0
          </span>
        </div>

        <!-- 1. BRAND SWITCHER GLOBAL (Fnac / Darty / Global IT) -->
        <div class="p-4 border-b border-slate-800/80 bg-slate-950/40">
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">
            Insígnia Ativa (Guardrail)
          </label>
          <div class="grid grid-cols-2 gap-1.5 bg-slate-900 p-1 rounded-lg border border-slate-800">
            <button
              type="button"
              data-switch-brand="FNAC"
              class="brand-btn py-1.5 px-2 rounded-md text-xs font-bold bg-[#E1A924] text-black shadow transition"
            >
              🟨 FNAC
            </button>
            <button
              type="button"
              data-switch-brand="DARTY"
              class="brand-btn py-1.5 px-2 rounded-md text-xs font-bold text-slate-400 hover:text-white transition"
            >
              🟥 DARTY
            </button>
          </div>
          <p class="mt-2 text-[11px] text-slate-400 leading-tight">
            Isolamento estrito: Lojas, Equipamentos, Playlists e Conteúdos filtram exclusivamente pela insígnia ativa.
          </p>
        </div>

        <!-- 2. SELETOR DE PERFIL RBAC (Para testar/operar Governance) -->
        <div class="p-4 border-b border-slate-800/80">
          <label for="role-selector" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1.5">
            Perfil de Governance (RBAC)
          </label>
          <select
            id="role-selector"
            class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-200 focus:outline-none focus:border-amber-400"
          >
            <option value="GLOBAL_ADMIN">GLOBAL_ADMIN (Admin Global / Multimédia)</option>
            <option value="MEDIA_MANAGER">MEDIA_MANAGER (Equipa Gestão Multimédia)</option>
            <option value="IT_OPS">IT_OPS (Suporte Técnico & Hardware)</option>
            <option value="STORE_MANAGER">STORE_MANAGER (Diretor Loja - ReadOnly)</option>
            <option value="DEPT_HEAD">DEPT_HEAD (Chefe Dept - ReadOnly)</option>
          </select>
        </div>

        <!-- Menu de Navegação Modular -->
        <nav class="p-3 space-y-1">
          <a
            href="/"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'overview'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>🏠 Visão Global (Home)</span>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">
              Compliance
            </span>
          </a>

          <a
            href="/devices/"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'devices'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>🖥️ Equipamentos (Parque IT)</span>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-semibold">
              ADB & Kiosk
            </span>
          </a>

          <a
            href="/content/"
            data-rbac-hide="STORE_MANAGER,DEPT_HEAD,IT_OPS"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'content'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>🎬 Conteúdos & Media</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold">
              Smart TAGs
            </span>
          </a>

          <a
            href="/playlists/"
            data-rbac-hide="STORE_MANAGER,DEPT_HEAD,IT_OPS"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'playlists'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>🎞️ Playlists (Slots & SoV)</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-semibold">
              4 Prioridades
            </span>
          </a>

          <a
            href="/store-wall/"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'store-wall'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>🏪 Lojas & Live Wall</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300">
              Auditoria
            </span>
          </a>

          <a
            href="/telemetry/"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'telemetry'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>📊 Relatórios & Proof of Play</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300">
              1 Ano CSV
            </span>
          </a>

          <a
            href="/settings/"
            data-rbac-hide="STORE_MANAGER,DEPT_HEAD"
            class:list={[
              'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition',
              activeNav === 'settings'
                ? 'bg-slate-800 text-white border-l-4 border-[#E1A924]'
                : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200',
            ]}
          >
            <span>⚙️ Configurações & Setup</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-semibold">
              Master Data
            </span>
          </a>

          <div class="pt-2 mt-2 border-t border-slate-800/80">
            <div class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-slate-500 bg-slate-950/40 border border-dashed border-slate-800">
              <span>🏷️ Catálogo SKU & Preços</span>
              <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
                Fase 6
              </span>
            </div>
          </div>
        </nav>
      </div>

      <!-- Footer Status Synology / Prod -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/60 text-xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-slate-400">PostgreSQL 16 (Part.):</span>
          <span class="text-emerald-400 font-mono font-semibold">ONLINE</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-400">Heartbeat Redis (60s):</span>
          <span class="text-emerald-400 font-mono font-semibold">3.984 ATIVOS</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-400">Supressão Noturna Expo:</span>
          <span class="text-amber-300 font-mono">ATIVA</span>
        </div>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Topbar -->
      <header class="h-16 bg-slate-900/70 border-b border-slate-800 px-8 flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-white">{title}</h2>
        </div>
        <div class="flex items-center gap-3">
          <!-- Módulo de Tema Dia / Noite / Auto -->
          <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
            <button
              type="button"
              data-theme-mode="LIGHT"
              class="theme-mode-btn px-2.5 py-1 rounded-md text-xs font-bold transition flex items-center gap-1"
              title="Modo Dia (Claro)"
            >
              <span>☀️</span>
              <span class="hidden sm:inline">Dia</span>
            </button>
            <button
              type="button"
              data-theme-mode="DARK"
              class="theme-mode-btn px-2.5 py-1 rounded-md text-xs font-bold transition flex items-center gap-1"
              title="Modo Noite (Escuro)"
            >
              <span>🌙</span>
              <span class="hidden sm:inline">Noite</span>
            </button>
            <button
              type="button"
              data-theme-mode="AUTO"
              class="theme-mode-btn px-2.5 py-1 rounded-md text-xs font-bold transition flex items-center gap-1"
              title="Automático (Dia 07:00–19:59 / Noite 20:00–06:59)"
            >
              <span>🔄</span>
              <span id="theme-auto-label" class="hidden sm:inline">Auto</span>
            </button>
          </div>

          <div id="rbac-banner" class="hidden xl:block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/30">
            Modo: GLOBAL_ADMIN (Controlo Total Multimédia & Hardware)
          </div>
        </div>
      </header>

      <main class="flex-1 p-8 overflow-y-auto">
        <slot />
      </main>
    </div>

    <script is:inline>
      // Gestão global de Brand Context (Fnac vs Darty) e RBAC Role no cliente
      const body = document.getElementById('app-body');
      const brandBadge = document.getElementById('brand-badge');
      const brandSubtitle = document.getElementById('brand-subtitle');
      const brandBtns = document.querySelectorAll('[data-switch-brand]');
      const roleSelector = document.getElementById('role-selector');
      const rbacBanner = document.getElementById('rbac-banner');

      function applyBrand(brand) {
        const cleanBrand = brand === 'DARTY' ? 'DARTY' : 'FNAC';
        localStorage.setItem('invision_brand', cleanBrand);
        body.setAttribute('data-brand', cleanBrand);

        brandBtns.forEach((btn) => {
          const b = btn.getAttribute('data-switch-brand');
          if (b === cleanBrand) {
            btn.className =
              cleanBrand === 'DARTY'
                ? 'brand-btn py-1.5 px-2 rounded-md text-xs font-bold bg-[#E30613] text-white shadow transition'
                : 'brand-btn py-1.5 px-2 rounded-md text-xs font-bold bg-[#E1A924] text-black shadow transition';
          } else {
            btn.className =
              'brand-btn py-1.5 px-2 rounded-md text-xs font-bold text-slate-400 hover:text-white transition';
          }
        });

        if (cleanBrand === 'DARTY') {
          brandBadge.textContent = 'DA';
          brandBadge.className =
            'w-10 h-10 rounded-lg bg-[#E30613] text-white font-black flex items-center justify-center text-lg shadow-lg transition-colors';
          brandSubtitle.textContent = 'Contexto Isolado: DARTY';
          brandSubtitle.className = 'text-xs text-red-400 font-medium';
        } else {
          brandBadge.textContent = 'FN';
          brandBadge.className =
            'w-10 h-10 rounded-lg bg-[#E1A924] text-black font-black flex items-center justify-center text-lg shadow-lg transition-colors';
          brandSubtitle.textContent = 'Contexto Isolado: FNAC';
          brandSubtitle.className = 'text-xs text-amber-400 font-medium';
        }

        // Filtra elementos da página marcados com data-brand-item
        document.querySelectorAll('[data-brand-item]').forEach((el) => {
          const itemBrand = el.getAttribute('data-brand-item');
          if (itemBrand === cleanBrand) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        window.dispatchEvent(new CustomEvent('invision:brand-change', { detail: { brand: cleanBrand } }));
      }

      function applyRole(role) {
        localStorage.setItem('invision_role', role);
        body.setAttribute('data-role', role);
        if (roleSelector) roleSelector.value = role;

        const labels = {
          GLOBAL_ADMIN: 'Modo: GLOBAL_ADMIN (Controlo Total Multimédia & Hardware)',
          MEDIA_MANAGER: 'Modo: MEDIA_MANAGER (Gestão de Playlists, Slots, SoV & Conteúdos)',
          IT_OPS: 'Modo: IT_OPS (Provisionamento Zero-Touch, Reboot & Rede)',
          STORE_MANAGER: 'Modo: STORE_MANAGER (Diretor de Loja — 100% Read-Only & Reporte de Incidentes)',
          DEPT_HEAD: 'Modo: DEPT_HEAD (Chefe de Departamento — 100% Read-Only & Auditoria Visual)',
        };
        if (rbacBanner) rbacBanner.textContent = labels[role] || role;

        // Esconde elementos restritos ao perfil atual
        document.querySelectorAll('[data-rbac-hide]').forEach((el) => {
          const hiddenFor = el.getAttribute('data-rbac-hide').split(',');
          if (hiddenFor.includes(role)) {
            el.classList.add('hidden');
          } else {
            el.classList.remove('hidden');
          }
        });

        window.dispatchEvent(new CustomEvent('invision:role-change', { detail: { role } }));
      }

      brandBtns.forEach((btn) => {
        btn.addEventListener('click', () => applyBrand(btn.getAttribute('data-switch-brand')));
      });

      if (roleSelector) {
        roleSelector.addEventListener('change', (e) => applyRole(e.target.value));
      }

      // =====================================================================
      // MOTOR DE TEMA DIA / NOITE (MANUAL & AUTOMÁTICO POR HORÁRIO)
      // =====================================================================
      const themeBtns = document.querySelectorAll('[data-theme-mode]');
      const autoLabel = document.getElementById('theme-auto-label');

      function resolveEffectiveTheme(mode) {
        if (mode === 'LIGHT') return 'light';
        if (mode === 'DARK') return 'dark';
        // Modo AUTO: Dia entre as 07:00 e as 19:59; Noite entre as 20:00 e as 06:59
        const hour = new Date().getHours();
        return hour >= 7 && hour < 20 ? 'light' : 'dark';
      }

      function applyThemeMode(mode) {
        const cleanMode = ['LIGHT', 'DARK', 'AUTO'].includes(mode) ? mode : 'AUTO';
        localStorage.setItem('invision_theme_mode', cleanMode);

        const effective = resolveEffectiveTheme(cleanMode);
        document.documentElement.setAttribute('data-theme', effective);
        if (effective === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        if (autoLabel) {
          autoLabel.textContent =
            cleanMode === 'AUTO'
              ? `Auto (${effective === 'light' ? 'Dia' : 'Noite'})`
              : 'Auto';
        }

        themeBtns.forEach((btn) => {
          const m = btn.getAttribute('data-theme-mode');
          if (m === cleanMode) {
            btn.className =
              'theme-mode-btn px-2.5 py-1 rounded-md text-xs font-bold bg-[#E1A924] text-black shadow transition flex items-center gap-1';
          } else {
            btn.className =
              'theme-mode-btn px-2.5 py-1 rounded-md text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-1';
          }
        });

        window.dispatchEvent(
          new CustomEvent('invision:theme-change', {
            detail: { mode: cleanMode, effective },
          })
        );
      }

      themeBtns.forEach((btn) => {
        btn.addEventListener('click', () =>
          applyThemeMode(btn.getAttribute('data-theme-mode'))
        );
      });

      applyBrand(localStorage.getItem('invision_brand') || 'FNAC');
      applyRole(localStorage.getItem('invision_role') || 'GLOBAL_ADMIN');
      applyThemeMode(localStorage.getItem('invision_theme_mode') || 'AUTO');

      // Reavalia a cada 60 segundos caso esteja em modo AUTO (transição automática às 07:00 e às 20:00)
      setInterval(() => {
        if ((localStorage.getItem('invision_theme_mode') || 'AUTO') === 'AUTO') {
          applyThemeMode('AUTO');
        }
      }, 60000);
    </script>
  </body>
</html>

