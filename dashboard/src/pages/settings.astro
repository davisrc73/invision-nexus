  <script is:inline>
    const API_BASE = `${window.location.protocol}//${window.location.hostname}:3000`;
    let liveState = null;
    let hasPromptedPurgeThisVisit = false;

    // Alternância de Tabs
    const tabBtns = document.querySelectorAll('[data-settings-tab]');
    const tabPanels = ['STORES', 'PROFILES', 'ZONES', 'CATEGORIES', 'RULES', 'SECURITY'];

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-settings-tab');
        tabBtns.forEach((b) => {
          if (b.getAttribute('data-settings-tab') === target) {
            b.className =
              'settings-tab-btn px-4 py-2 rounded-lg text-xs font-black bg-[#E1A924] text-black shadow transition';
          } else {
            b.className =
              'settings-tab-btn px-4 py-2 rounded-lg text-xs font-bold bg-slate-900 text-slate-300 border border-slate-800 hover:border-slate-700 transition';
          }
        });
        tabPanels.forEach((p) => {
          const el = document.getElementById(`tab-panel-${p}`);
          if (el) {
            if (p === target) el.classList.remove('hidden');
            else el.classList.add('hidden');
          }
        });
      });
    });

    async function postSettingsAction(payload) {
      const res = await fetch(`${API_BASE}/api/v1/live/settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.state) {
        liveState = data.state;
        renderSettings();
      }
    }

    async function fetchSettingsState() {
      const res = await fetch(`${API_BASE}/api/v1/live/state`);
      liveState = await res.json();
      renderSettings();
    }

    function renderSettings() {
      if (!liveState) return;

      const stores = liveState.storesCatalog || [];
      const hasDemoStores = stores.some((s) => s.isDemo);
      const isProdStrict = Boolean(liveState.productionStrictMode) && !hasDemoStores;

      // Pop-up automático sempre que acede à área e ainda existem dados de simulação!
      const modal = document.getElementById('demo-purge-modal');
      if (!hasPromptedPurgeThisVisit && (hasDemoStores || !liveState.productionStrictMode)) {
        hasPromptedPurgeThisVisit = true;
        modal?.classList.remove('hidden');
      }

      const envBadge = document.getElementById('env-mode-badge');
      const btnPurge = document.getElementById('btn-open-purge-dialog');
      const btnRestore = document.getElementById('btn-restore-demo');

      if (isProdStrict) {
        if (envBadge) {
          envBadge.textContent = '🟢 MODO PRODUÇÃO REAL (Sem Dados Demo)';
          envBadge.className =
            'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        }
        btnPurge?.classList.add('hidden');
        btnRestore?.classList.remove('hidden');
      } else {
        if (envBadge) {
          envBadge.textContent = '🟡 MODO SIMULAÇÃO / DEMO ATIVO';
          envBadge.className =
            'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30';
        }
        btnPurge?.classList.remove('hidden');
        btnRestore?.classList.add('hidden');
      }

      // 1. Renderiza Tabela de Lojas (Filtrada pela Insígnia Ativa)
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const stBrandEl = document.getElementById('st-brand');
      if (stBrandEl && !stBrandEl.value) {
        stBrandEl.value = activeBrand;
      }

      const brandStores = stores.filter((s) => !s.brand || s.brand === activeBrand);
      document.getElementById('stores-total-label').textContent = `${brandStores.length} (${activeBrand})`;
      const storesTbody = document.getElementById('settings-stores-tbody');
      if (brandStores.length === 0) {
        storesTbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-8 text-center text-slate-400">
              Nenhuma loja registada para <strong>${activeBrand}</strong>. Utilize o formulário acima ou a Importação CSV ao lado para criar as suas Lojas Reais.
            </td>
          </tr>
        `;
      } else {
        storesTbody.innerHTML = brandStores
          .map(
            (s) => `
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-2.5 px-3 font-mono font-bold text-amber-300">#${s.code}</td>
              <td class="py-2.5 px-3 font-bold">${s.brand} (${s.country})</td>
              <td class="py-2.5 px-3 text-slate-300">${s.region || 'Geral'}</td>
              <td class="py-2.5 px-3">
                <strong class="text-white">${s.name}</strong>
                <span class="text-slate-400 ml-1">(${s.city})</span>
              </td>
              <td class="py-2.5 px-3 font-mono text-emerald-300">${s.gatewaySubnet || '—'}</td>
              <td class="py-2.5 px-3 font-mono text-slate-400">${s.lat}, ${s.lng}</td>
              <td class="py-2.5 px-3">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono ${
                  s.isDemo
                    ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30'
                    : 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-bold'
                }">
                  ${s.isDemo ? 'DEMO' : 'REAL'}
                </span>
              </td>
              <td class="py-2.5 px-3 text-right space-x-1.5">
                <button
                  type="button"
                  data-edit-store="${s.id}"
                  class="px-2 py-1 rounded bg-slate-800 hover:bg-amber-400 hover:text-black text-slate-300 font-bold text-[11px] transition"
                >
                  ✎ Editar
                </button>
                <button
                  type="button"
                  data-del-store="${s.id}"
                  class="px-2 py-1 rounded bg-slate-950 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-[11px] transition"
                >
                  ✕
                </button>
              </td>
            </tr>
          `
          )
          .join('');

        document.querySelectorAll('[data-edit-store]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-edit-store');
            const st = stores.find((x) => x.id === id);
            if (!st) return;
            document.getElementById('st-id').value = st.id;
            document.getElementById('st-brand').value = st.brand;
            document.getElementById('st-country').value = st.country;
            document.getElementById('st-code').value = st.code;
            document.getElementById('st-region').value = st.region || 'Grande Lisboa';
            document.getElementById('st-city').value = st.city;
            document.getElementById('st-name').value = st.name;
            document.getElementById('st-gateway').value = st.gatewaySubnet || '';
            document.getElementById('st-lat').value = st.lat;
            document.getElementById('st-lng').value = st.lng;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });

        document.querySelectorAll('[data-del-store]').forEach((btn) => {
          btn.addEventListener('click', () => {
            postSettingsAction({
              action: 'DELETE_STORE',
              id: btn.getAttribute('data-del-store'),
            });
          });
        });
      }

      // 2. Renderiza Formatos de Ecrã
      const profiles = liveState.screenProfilesCatalog || [];
      const profGrid = document.getElementById('settings-profiles-grid');
      profGrid.innerHTML = profiles
        .map(
          (p) => `
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between gap-3">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                  ${p.code}
                </span>
                <span class="text-[11px] font-mono text-emerald-300">
                  ${p.widthPx}x${p.heightPx} (${p.aspectRatio})
                </span>
              </div>
              <h5 class="text-sm font-bold text-white mt-2">${p.name}</h5>
              <p class="text-[11px] font-mono text-slate-400 mt-1">
                Orientação: <strong>${p.orientation}</strong> • Inversão 180° Padrão: <strong>${p.defaultInvert180 ? 'SIM (Pernas p/ o Ar)' : 'NÃO (Normal)'}</strong>
              </p>
            </div>
            <div class="flex justify-end">
              <button
                type="button"
                data-del-profile="${p.id}"
                class="px-2.5 py-1 rounded bg-slate-950 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-xs transition"
              >
                ✕ Remover Formato
              </button>
            </div>
          </div>
        `
        )
        .join('');

      document.querySelectorAll('[data-del-profile]').forEach((btn) => {
        btn.addEventListener('click', () => {
          postSettingsAction({
            action: 'DELETE_PROFILE',
            id: btn.getAttribute('data-del-profile'),
          });
        });
      });

      // 3. Renderiza Áreas de Loja
      const zones = liveState.zonesCatalog || [];
      const zonesGrid = document.getElementById('settings-zones-grid');
      zonesGrid.innerHTML = zones
        .map(
          (z) => `
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
            <div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 font-bold">
                ${z.code}
              </span>
              <h5 class="text-sm font-bold text-white mt-1.5">${z.name}</h5>
              <p class="text-xs text-slate-400 mt-0.5">${z.description || ''}</p>
            </div>
            <button
              type="button"
              data-del-zone="${z.id}"
              class="px-2.5 py-1.5 rounded bg-slate-950 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-xs transition"
            >
              ✕
            </button>
          </div>
        `
        )
        .join('');

      document.querySelectorAll('[data-del-zone]').forEach((btn) => {
        btn.addEventListener('click', () => {
          postSettingsAction({
            action: 'DELETE_ZONE',
            id: btn.getAttribute('data-del-zone'),
          });
        });
      });

      // 4. Renderiza Tipologias de Equipamento
      const cats = liveState.categoriesCatalog || [];
      const catsGrid = document.getElementById('settings-categories-grid');
      catsGrid.innerHTML = cats
        .map(
          (c) => `
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
            <div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold">
                ${c.code}
              </span>
              <h5 class="text-sm font-bold text-white mt-1.5">${c.icon || '🖥️'} ${c.name}</h5>
              <p class="text-[11px] font-mono text-amber-300 mt-0.5">Modo Padrão: ${c.defaultMode}</p>
            </div>
            <button
              type="button"
              data-del-cat="${c.id}"
              class="px-2.5 py-1.5 rounded bg-slate-950 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-xs transition"
            >
              ✕
            </button>
          </div>
        `
        )
        .join('');

      document.querySelectorAll('[data-del-cat]').forEach((btn) => {
        btn.addEventListener('click', () => {
          postSettingsAction({
            action: 'DELETE_CATEGORY',
            id: btn.getAttribute('data-del-cat'),
          });
        });
      });

      // 5. Renderiza Precedência & Regras de Playlists
      const levels = [
        {
          code: 'EXCLUSIVA',
          label: '1. EXCLUSIVA',
          tag: 'OVERRIDE TOTAL 100%',
          desc: 'Silencia a 100% todas as outras playlists (Prioritária, Normal e Fallback). Usada para Flash Sales, Takeovers ou Emergências.',
          color: 'border-rose-500/40 bg-rose-500/10 text-rose-300',
        },
        {
          code: 'PRIORITARIA',
          label: '2. PRIORITÁRIA',
          tag: 'CAMPANHA COMERCIAL',
          desc: 'Silencia a 100% a programação Regular/Normal. Ideal para campanhas com período marcado (ex: Natal, Dias Fnac).',
          color: 'border-amber-500/40 bg-amber-500/10 text-amber-300',
        },
        {
          code: 'NORMAL',
          label: '3. NORMAL',
          tag: 'SLOTS & SHARE OF VOICE %',
          desc: 'Programação regular do dia a dia da loja. Pode correr em grelha fixa (Slots) ou ponderada por percentagem de Share of Voice.',
          color: 'border-sky-500/40 bg-sky-500/10 text-sky-300',
        },
        {
          code: 'FALLBACK',
          label: '4. FALLBACK',
          tag: 'SEGURANÇA DE REDE',
          desc: 'Ativa automaticamente e mantém os ecrãs iluminados com segurança quando nenhuma playlist superior estiver ativa.',
          color: 'border-slate-700 bg-slate-950 text-slate-300',
        },
      ];

      const brandPlaylists = (liveState.playlists || []).filter(
        (p) => !p.brand || p.brand === activeBrand
      );
      const effWinning = liveState.effectivePlayback?.activePriority || 'FALLBACK';

      const winningBadge = document.getElementById('rules-winning-badge');
      if (winningBadge) {
        winningBadge.textContent = `● Prioridade Dominante: ${effWinning} (${activeBrand})`;
      }

      const rulesGrid = document.getElementById('rules-priority-grid');
      if (rulesGrid) {
        rulesGrid.innerHTML = levels
          .map((lvl) => {
            const count = brandPlaylists.filter(
              (p) => p.priority === lvl.code && p.isActive && p.items?.length > 0
            ).length;
            const isWinning = effWinning === lvl.code;
            return `
              <div class="p-4 rounded-xl border ${lvl.color} flex flex-col justify-between gap-3 ${
                isWinning ? 'ring-2 ring-emerald-400' : ''
              }">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <strong class="text-sm font-black text-white">${lvl.label}</strong>
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded ${
                      isWinning ? 'bg-emerald-400 text-black' : 'bg-slate-800 text-slate-300'
                    }">
                      ${isWinning ? '● NO AR AGORA' : `${count} Ativa(s)`}
                    </span>
                  </div>
                  <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300 block w-fit mb-2">
                    ${lvl.tag}
                  </span>
                  <p class="text-xs text-slate-300 leading-relaxed">${lvl.desc}</p>
                </div>
                <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
                  <span>Playlists Ativas (${activeBrand}):</span>
                  <strong class="text-white">${count}</strong>
                </div>
              </div>
            `;
          })
          .join('');
      }

      // 6. Renderiza Segurança, SSO Entra ID & Trilho de Auditoria
      const auth = liveState.authStatus || {};
      const ssoBadge = document.getElementById('security-sso-badge');
      if (ssoBadge) {
        if (auth.ssoConfigured) {
          ssoBadge.textContent = '🟢 ATIVO (Pronto p/ Produção)';
          ssoBadge.className =
            'px-2.5 py-1 rounded text-xs font-mono font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        } else {
          ssoBadge.textContent = '🟡 A aguardar Registo Azure';
          ssoBadge.className =
            'px-2.5 py-1 rounded text-xs font-mono font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30';
        }
      }

      const redirectUriEl = document.getElementById('security-redirect-uri');
      if (redirectUriEl) {
        redirectUriEl.textContent = `${API_BASE}/api/v1/auth/microsoft/callback`;
      }
      const tenantEl = document.getElementById('security-tenant-id');
      if (tenantEl) {
        tenantEl.textContent = auth.tenantId || 'Definir no .env (AZURE_TENANT_ID)';
      }
      const clientEl = document.getElementById('security-client-id');
      if (clientEl) {
        clientEl.textContent = auth.clientId || 'Definir no .env (AZURE_CLIENT_ID)';
      }

      // Renderiza Trilho de Auditoria
      const auditTbody = document.getElementById('security-audit-tbody');
      const logs = liveState.auditLogs || [];
      if (auditTbody) {
        if (logs.length === 0) {
          auditTbody.innerHTML = `
            <tr>
              <td colspan="7" class="py-6 text-center text-slate-500">
                Nenhuma operação sensível registada no trilho de auditoria até ao momento.
              </td>
            </tr>
          `;
        } else {
          auditTbody.innerHTML = logs
            .map((log) => {
              const dateStr = new Date(log.timestamp).toLocaleString('pt-PT');
              const isOk = log.success !== false;
              return `
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="py-2.5 px-3 text-slate-400 whitespace-nowrap">${dateStr}</td>
                  <td class="py-2.5 px-3 font-bold ${
                    isOk ? 'text-amber-400' : 'text-rose-400'
                  }">${log.action}</td>
                  <td class="py-2.5 px-3 text-slate-200">${log.actor}</td>
                  <td class="py-2.5 px-3">
                    <span class="px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-300 border border-slate-700">
                      ${log.role}
                    </span>
                  </td>
                  <td class="py-2.5 px-3 text-slate-300 max-w-xs truncate" title="${log.details || log.target || ''}">
                    ${log.target ? `[${log.target}] ` : ''}${log.details || '-'}
                  </td>
                  <td class="py-2.5 px-3 text-slate-400">${log.clientIp || '-'}</td>
                  <td class="py-2.5 px-3 text-right">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                      isOk
                        ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                        : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'
                    }">
                      ${isOk ? 'SUCESSO' : 'BLOQUEADO'}
                    </span>
                  </td>
                </tr>
              `;
            })
            .join('');
        }
      }
    }

    document.getElementById('btn-refresh-audit')?.addEventListener('click', async () => {
      await fetchSettingsState();
    });

    // Re-renderiza quando a insígnia for alterada no topo
    window.addEventListener('invision:brand-change', () => {
      renderSettings();
    });

    // Eventos do Pop-up de Purge Demo
    const modal = document.getElementById('demo-purge-modal');
    document.getElementById('btn-close-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('btn-keep-demo')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('btn-open-purge-dialog')?.addEventListener('click', () => modal?.classList.remove('hidden'));

    document.getElementById('btn-confirm-purge-modal')?.addEventListener('click', async () => {
      await postSettingsAction({ action: 'PURGE_DEMO_DATA' });
      modal?.classList.add('hidden');
    });

    document.getElementById('btn-restore-demo')?.addEventListener('click', async () => {
      await postSettingsAction({ action: 'RESTORE_DEMO_DATA' });
    });

    // Submissão Loja Individual
    document.getElementById('store-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await postSettingsAction({
        action: 'UPSERT_STORE',
        store: {
          id: document.getElementById('st-id').value || undefined,
          brand: document.getElementById('st-brand').value,
          country: document.getElementById('st-country').value,
          code: document.getElementById('st-code').value,
          region: document.getElementById('st-region').value,
          city: document.getElementById('st-city').value,
          name: document.getElementById('st-name').value,
          gatewaySubnet: document.getElementById('st-gateway').value,
          lat: Number(document.getElementById('st-lat').value || 38.753),
          lng: Number(document.getElementById('st-lng').value || -9.189),
        },
      });
      document.getElementById('store-form').reset();
      document.getElementById('st-id').value = '';
    });

    // Importação CSV em Lote
    document.getElementById('btn-bulk-import-stores')?.addEventListener('click', async () => {
      const raw = document.getElementById('bulk-stores-csv')?.value || '';
      const lines = raw
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter(Boolean);
      if (lines.length === 0) return;

      const parsedStores = lines.map((line) => {
        const parts = line.split(/[;,]/).map((s) => s.trim());
        return {
          code: parts[0] || '1',
          brand: parts[1] || 'FNAC',
          country: parts[2] || 'PT',
          region: parts[3] || 'Geral',
          city: parts[4] || 'Lisboa',
          name: parts[5] || `Loja #${parts[0]}`,
          gatewaySubnet: parts[6] || '',
          lat: Number(parts[7] || 38.753),
          lng: Number(parts[8] || -9.189),
        };
      });

      await postSettingsAction({
        action: 'BULK_IMPORT_STORES',
        stores: parsedStores,
      });
      document.getElementById('bulk-stores-csv').value = '';
    });

    // Submissão Formato de Ecrã
    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const w = Number(document.getElementById('sp-width').value || 1920);
      const h = Number(document.getElementById('sp-height').value || 1080);
      await postSettingsAction({
        action: 'UPSERT_PROFILE',
        profile: {
          code: document.getElementById('sp-code').value,
          name: document.getElementById('sp-name').value,
          widthPx: w,
          heightPx: h,
          orientation: h > w ? 'VERTICAL' : 'HORIZONTAL',
          defaultInvert180: document.getElementById('sp-invert180').checked,
        },
      });
      document.getElementById('profile-form').reset();
    });

    // Submissão Área de Loja
    document.getElementById('zone-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await postSettingsAction({
        action: 'UPSERT_ZONE',
        zone: {
          code: document.getElementById('zn-code').value,
          name: document.getElementById('zn-name').value,
          description: document.getElementById('zn-desc').value,
        },
      });
      document.getElementById('zone-form').reset();
    });

    // Submissão Tipologia
    document.getElementById('category-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await postSettingsAction({
        action: 'UPSERT_CATEGORY',
        category: {
          code: document.getElementById('cat-code').value,
          name: document.getElementById('cat-name').value,
          defaultMode: document.getElementById('cat-mode').value,
        },
      });
      document.getElementById('category-form').reset();
    });

    fetchSettingsState();
  </script>
</DashboardLayout>

