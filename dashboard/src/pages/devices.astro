---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="Gestão e Controlo de Parque Informático & Equipamentos (Boxes ADB, TVs & Bancadas)"
  activeNav="devices"
>
  <!-- BARRA DE FILTROS E AÇÕES RÁPIDAS -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 mb-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="flex items-center gap-3 flex-wrap">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Filtro Loja:
      </span>
      <select
        id="dev-filter-store"
        class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-400 focus:outline-none"
      >
        <option value="ALL">Todas as Lojas</option>
      </select>

      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Tipologia:
      </span>
      <select
        id="dev-filter-category"
        class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-sky-300 font-mono focus:border-amber-400 focus:outline-none"
      >
        <option value="ALL">Todas as Categorias</option>
      </select>

      <button
        type="button"
        id="btn-clear-dev-filters"
        class="text-xs text-amber-400 hover:underline font-mono"
      >
        Limpar Filtros
      </button>
    </div>

    <!-- BOTÕES DE AÇÃO: MODAIS DE EMPARELHAMENTO & ADB (ALINHADOS À DIREITA) -->
    <div class="flex items-center gap-2.5 flex-wrap justify-end">
      <button
        type="button"
        id="btn-open-pairing-modal"
        class="px-3.5 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-xs transition shadow flex items-center gap-1.5"
      >
        <span>⚡ + Emparelhar Terminal</span>
      </button>

      <button
        type="button"
        id="btn-open-adb-modal"
        data-rbac-hide="MEDIA_MANAGER,STORE_MANAGER,DEPT_HEAD"
        class="px-3.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 font-bold text-xs transition flex items-center gap-2"
      >
        <span>📺 Provisionamento ADB & Watchdog</span>
        <span id="adb-count-pill" class="px-1.5 py-0.2 rounded bg-emerald-500 text-black font-black text-[10px]">
          0 Boxes
        </span>
      </button>
    </div>
  </div>

  <!-- INVENTÁRIO REAL-TIME A 100% DA LARGURA (FULL-WIDTH) -->
  <div class="w-full bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8">
    <div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
      <div>
        <span class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          Inventário Real-Time (LAN / Heartbeat)
        </span>
        <h3 class="text-base font-bold text-white mt-1.5">
          Terminais e Players Conectados Agora
        </h3>
      </div>
      <div class="flex items-center gap-3">
        <span id="dev-active-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          0 Terminais na LAN
        </span>
        <a href="/store-wall/" class="text-xs text-sky-400 hover:underline font-semibold">
          Abrir Live Wall Visual →
        </a>
      </div>
    </div>

    <div id="live-devices-list" class="space-y-3 text-xs">
      <div class="p-4 rounded-lg bg-slate-950 border border-slate-800 text-slate-400">
        A carregar equipamentos ligados...
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL: PROVISIONAMENTO & CONTROLO KIOSK ADB                           -->
  <!-- ===================================================================== -->
  <div
    id="adb-modal"
    class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
  >
    <div class="max-w-3xl w-full bg-slate-900 border-2 border-emerald-500/60 rounded-2xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
        <div>
          <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Controlo Remoto ADB Integrado no NAS
          </span>
          <h3 class="text-base font-bold text-white mt-1">
            📺 Provisionamento Kiosk ADB & Auto-Boot Watchdog (Boxes Android X98 Plus)
          </h3>
        </div>
        <button
          type="button"
          id="btn-close-adb-modal"
          class="text-slate-400 hover:text-white text-lg font-bold p-1 rounded-lg hover:bg-slate-800 transition"
        >
          ✕
        </button>
      </div>

      <p class="text-xs text-slate-300 mb-4 leading-relaxed">
        Ligue, abra o Player PWA em Fullscreen (Single-Tab, sem barra de tradução) e mantenha o Watchdog Pós-Reboot ativo a cada 12 segundos.
      </p>

      <form id="adb-provision-form" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end mb-4">
        <div class="md:col-span-4">
          <label class="block text-xs text-slate-400 mb-1">IP da Box Android X98 Plus</label>
          <input
            type="text"
            id="adb-box-ip"
            placeholder="192.168.68.115"
            value="192.168.68.115"
            required
            class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-emerald-300 focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div class="md:col-span-5">
          <label class="block text-xs text-slate-400 mb-1">Endereço do Player PWA</label>
          <input
            type="text"
            id="adb-player-url"
            placeholder="http://192.168.68.117:5174"
            required
            class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-sky-300 focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div class="md:col-span-3">
          <button
            type="submit"
            id="adb-submit-btn"
            class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-black text-xs py-2.5 px-3 rounded-lg transition shadow"
          >
            🚀 Provisionar Box
          </button>
        </div>
      </form>

      <pre
        id="adb-console-log"
        class="hidden mb-4 p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-slate-300 whitespace-pre-wrap leading-relaxed"
      ></pre>

      <div class="border-t border-slate-800 pt-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">
          Boxes Android Monitorizadas pelo Watchdog do NAS (Auto-Arranque Pós-Reboot a cada 12s)
        </h4>
        <div id="adb-boxes-list" class="space-y-2.5 text-xs"></div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL: EMPARELHAMENTO ZERO-TOUCH & CONFIGURAÇÃO DE EQUIPAMENTO        -->
  <!-- ===================================================================== -->
  <div
    id="pairing-modal"
    class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
  >
    <div class="max-w-2xl w-full bg-slate-900 border-2 border-[#E1A924] rounded-2xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
        <div>
          <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
            Emparelhamento & Setup de Terminal
          </span>
          <h3 id="pairing-modal-title" class="text-base font-bold text-white mt-1">
            Configurar Equipamento
          </h3>
        </div>
        <button
          type="button"
          id="btn-close-pairing-modal"
          class="text-slate-400 hover:text-white text-lg font-bold p-1 rounded-lg hover:bg-slate-800 transition"
        >
          ✕
        </button>
      </div>

      <p class="text-xs text-slate-300 mb-4">
        Associe o código único do ecrã à Loja, Zona, Categoria, Formato e ajuste a orientação se necessário.
      </p>

      <form id="pairing-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Código de Emparelhamento ou UID</label>
            <input
              type="text"
              id="pair-code"
              placeholder="NX-849201"
              required
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono uppercase text-amber-300 focus:border-amber-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Nome Amigável do Terminal</label>
            <input
              type="text"
              id="pair-name"
              placeholder="Ex: Box X98 Entrada Principal"
              required
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Loja de Destino</label>
            <select
              id="pair-store"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200"
            ></select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Zona / Área de Loja</label>
            <select
              id="pair-zone"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200"
            ></select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Categoria / Tipologia</label>
            <select
              id="pair-category"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200"
            ></select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Formato / Resolução</label>
            <select
              id="pair-profile"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-emerald-300"
            ></select>
          </div>
        </div>

        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between">
          <div>
            <span class="text-xs font-bold text-amber-300 block">🔄 Inversão de Ecrã 180° ("Pernas para o ar")</span>
            <span class="text-[11px] text-slate-400">Ative caso o ecrã físico tenha sido instalado de cabeça para baixo.</span>
          </div>
          <input type="checkbox" id="pair-invert180" class="accent-amber-400 w-5 h-5 cursor-pointer" />
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="button"
            id="btn-cancel-pairing"
            class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-black text-xs transition shadow"
          >
            Guardar Configuração
          </button>
        </div>
      </form>

      <div
        id="pair-feedback"
        class="hidden mt-3 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-300 font-mono"
      ></div>
    </div>
  </div>

  <script is:inline>
    const API_BASE = `${window.location.protocol}//${window.location.hostname}:3000`;
    let isPlayerUrlInitialized = false;

    // Modais
    const adbModal = document.getElementById('adb-modal');
    const pairingModal = document.getElementById('pairing-modal');
    const btnOpenAdb = document.getElementById('btn-open-adb-modal');
    const btnCloseAdb = document.getElementById('btn-close-adb-modal');
    const btnOpenPairing = document.getElementById('btn-open-pairing-modal');
    const btnClosePairing = document.getElementById('btn-close-pairing-modal');
    const btnCancelPairing = document.getElementById('btn-cancel-pairing');
    const pairingModalTitle = document.getElementById('pairing-modal-title');

    function openAdbModal() {
      adbModal?.classList.remove('hidden');
    }
    function closeAdbModal() {
      adbModal?.classList.add('hidden');
    }
    function openPairingModal(isNew = false) {
      if (isNew) {
        if (pairingModalTitle) pairingModalTitle.textContent = 'Emparelhar Novo Terminal (Zero-Touch)';
        const codeInput = document.getElementById('pair-code');
        if (codeInput && !codeInput.value) {
          codeInput.value = `NX-${Math.floor(100000 + Math.random() * 900000)}`;
        }
        document.getElementById('pair-name').value = '';
        const invEl = document.getElementById('pair-invert180');
        if (invEl) invEl.checked = false;
      }
      pairingModal?.classList.remove('hidden');
    }
    function closePairingModal() {
      pairingModal?.classList.add('hidden');
      const feedback = document.getElementById('pair-feedback');
      if (feedback) feedback.classList.add('hidden');
    }

    btnOpenAdb?.addEventListener('click', openAdbModal);
    btnCloseAdb?.addEventListener('click', closeAdbModal);
    btnOpenPairing?.addEventListener('click', () => openPairingModal(true));
    btnClosePairing?.addEventListener('click', closePairingModal);
    btnCancelPairing?.addEventListener('click', closePairingModal);

    // Fecha modal clicando no backdrop
    adbModal?.addEventListener('click', (e) => {
      if (e.target === adbModal) closeAdbModal();
    });
    pairingModal?.addEventListener('click', (e) => {
      if (e.target === pairingModal) closePairingModal();
    });

    // Tecla Escape para fechar modais
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAdbModal();
        closePairingModal();
      }
    });

    // Filtros
    const urlParams = new URLSearchParams(window.location.search);
    const initialStore = urlParams.get('store');
    const initialCategory = urlParams.get('category');

    const storeFilterEl = document.getElementById('dev-filter-store');
    const catFilterEl = document.getElementById('dev-filter-category');

    if (initialStore && storeFilterEl) {
      const exists = Array.from(storeFilterEl.options).some((o) => o.value === initialStore);
      if (!exists) {
        const opt = document.createElement('option');
        opt.value = initialStore;
        opt.textContent = initialStore;
        storeFilterEl.appendChild(opt);
      }
      storeFilterEl.value = initialStore;
    }

    if (initialCategory && catFilterEl) {
      catFilterEl.value = initialCategory;
    }

    document.getElementById('btn-clear-dev-filters')?.addEventListener('click', () => {
      if (storeFilterEl) storeFilterEl.value = 'ALL';
      if (catFilterEl) catFilterEl.value = 'ALL';
      window.history.replaceState({}, '', '/devices/');
      refreshDevicesPage();
    });

    storeFilterEl?.addEventListener('change', refreshDevicesPage);
    catFilterEl?.addEventListener('change', refreshDevicesPage);

    // Recarrega sempre que a insígnia (FNAC / DARTY) for alternada no topo
    window.addEventListener('invision:brand-change', () => {
      refreshDevicesPage();
    });

    async function refreshDevicesPage() {
      try {
        const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
        const res = await fetch(`${API_BASE}/api/v1/live/state`);
        const st = await res.json();

        const adbUrlInput = document.getElementById('adb-player-url');
        if (adbUrlInput && !isPlayerUrlInitialized) {
          const detectedPort =
            window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
              ? 5173
              : st.publicPlayerPort || 5174;
          adbUrlInput.value = `${window.location.protocol}//${window.location.hostname}:${detectedPort}`;
          isPlayerUrlInitialized = true;
        }

        // Lojas da insígnia ativa
        const allStores = st.storesCatalog || [];
        const brandStores = allStores.filter((s) => !s.brand || s.brand === activeBrand);

        if (Array.isArray(brandStores) && brandStores.length > 0) {
          const pairStoreEl = document.getElementById('pair-store');
          if (pairStoreEl) {
            const curVal = pairStoreEl.value;
            pairStoreEl.innerHTML = brandStores
              .map(
                (s) =>
                  `<option value="${s.name}">${s.name} (${s.region || s.city}${s.gatewaySubnet ? ' • ' + s.gatewaySubnet : ''})</option>`
              )
              .join('');
            if (curVal && Array.from(pairStoreEl.options).some((o) => o.value === curVal)) {
              pairStoreEl.value = curVal;
            }
          }
          if (storeFilterEl) {
            const curFilter = storeFilterEl.value;
            storeFilterEl.innerHTML =
              `<option value="ALL">Todas as Lojas (${brandStores.length})</option>` +
              brandStores
                .map((s) => `<option value="${s.name}">${s.name} (${s.city})</option>`)
                .join('');
            if (curFilter && Array.from(storeFilterEl.options).some((o) => o.value === curFilter)) {
              storeFilterEl.value = curFilter;
            }
          }
        }

        if (Array.isArray(st.zonesCatalog) && st.zonesCatalog.length > 0) {
          const pairZoneEl = document.getElementById('pair-zone');
          if (pairZoneEl) {
            const curVal = pairZoneEl.value;
            pairZoneEl.innerHTML = st.zonesCatalog
              .map((z) => `<option value="${z.code}">${z.name} (${z.code})</option>`)
              .join('');
            if (curVal && Array.from(pairZoneEl.options).some((o) => o.value === curVal)) {
              pairZoneEl.value = curVal;
            }
          }
        }

        if (Array.isArray(st.categoriesCatalog) && st.categoriesCatalog.length > 0) {
          const pairCatEl = document.getElementById('pair-category');
          if (pairCatEl) {
            const curVal = pairCatEl.value;
            pairCatEl.innerHTML = st.categoriesCatalog
              .map((c) => `<option value="${c.code}">${c.icon || ''} ${c.code} (${c.name})</option>`)
              .join('');
            if (curVal && Array.from(pairCatEl.options).some((o) => o.value === curVal)) {
              pairCatEl.value = curVal;
            }
          }
          if (catFilterEl) {
            const curCat = catFilterEl.value;
            catFilterEl.innerHTML =
              `<option value="ALL">Todas as Categorias (${st.categoriesCatalog.length})</option>` +
              st.categoriesCatalog
                .map((c) => `<option value="${c.code}">${c.icon || ''} ${c.code} (${c.name})</option>`)
                .join('');
            if (curCat && Array.from(catFilterEl.options).some((o) => o.value === curCat)) {
              catFilterEl.value = curCat;
            }
          }
        }

        if (Array.isArray(st.screenProfilesCatalog) && st.screenProfilesCatalog.length > 0) {
          const pairProfEl = document.getElementById('pair-profile');
          if (pairProfEl) {
            const curVal = pairProfEl.value;
            pairProfEl.innerHTML = st.screenProfilesCatalog
              .map(
                (p) =>
                  `<option value="${p.aspectRatio}" data-invert="${p.invert180 ? '1' : '0'}">${p.widthPx}x${p.heightPx} (${p.aspectRatio}) — ${p.name}</option>`
              )
              .join('');
            if (curVal && Array.from(pairProfEl.options).some((o) => o.value === curVal)) {
              pairProfEl.value = curVal;
            }
          }
        }

        // Renderiza Boxes Android ADB
        const adbCountPill = document.getElementById('adb-count-pill');
        const adbBoxes = st.adbBoxes || [];
        if (adbCountPill) {
          adbCountPill.textContent = `${adbBoxes.length} ${adbBoxes.length === 1 ? 'Box' : 'Boxes'}`;
        }

        const adbBoxesEl = document.getElementById('adb-boxes-list');
        if (adbBoxesEl) {
          if (adbBoxes.length === 0) {
            adbBoxesEl.innerHTML = `
              <div class="p-3 rounded-lg bg-slate-950 border border-dashed border-slate-800 text-slate-400">
                Nenhuma Box Android registada no Watchdog ADB. Introduza o IP acima (ex: <code>192.168.68.115</code>) e clique em <strong>Provisionar Box</strong>.
              </div>
            `;
          } else {
            adbBoxesEl.innerHTML = adbBoxes
              .map(
                (b) => `
                <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="w-2.5 h-2.5 rounded-full ${
                        String(b.status).startsWith('ONLINE') || String(b.status).startsWith('AUTO-RECOVERED')
                          ? 'bg-emerald-400'
                          : 'bg-amber-400 animate-pulse'
                      }"></span>
                      <strong class="text-white font-mono text-xs">Box IP: ${b.boxIp}:5555</strong>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                        ${b.status || 'MONITORIZADO'}
                      </span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded ${
                        b.autoWatchdog !== false
                          ? 'bg-sky-500/15 text-sky-300 border border-sky-500/30'
                          : 'bg-slate-800 text-slate-400'
                      }">
                        Watchdog: ${b.autoWatchdog !== false ? 'ATIVO (12s)' : 'PAUSADO'}
                      </span>
                    </div>
                    <p class="text-[11px] font-mono text-slate-400 mt-1">
                      URL Kiosk: <span class="text-sky-300">${b.playerUrl}</span>
                    </p>
                  </div>
                  <div class="flex items-center gap-1.5 flex-wrap shrink-0">
                    <button
                      type="button"
                      data-adb-action="RELAUNCH_URL"
                      data-adb-ip="${b.boxIp}"
                      data-adb-url="${b.playerUrl}"
                      class="px-2.5 py-1.5 rounded bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-500/30 font-bold text-[11px] transition"
                      title="Relança o Player e reativa a supervisão"
                    >
                      🔄 Abrir URL
                    </button>
                    <button
                      type="button"
                      data-adb-action="FORCE_STOP_PLAYER"
                      data-adb-ip="${b.boxIp}"
                      class="px-2.5 py-1.5 rounded bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 font-bold text-[11px] transition"
                      title="Pára imediatamente o Player e pausa o Watchdog para poderes usar o Android Desktop"
                    >
                      🛑 Parar Player
                    </button>
                    <button
                      type="button"
                      data-adb-action="CLEAR_TABS"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-[11px] transition"
                      title="Limpa 100% das abas acumuladas do Chrome (Chrome Reset)"
                    >
                      🧹 Limpar Abas
                    </button>
                    <button
                      type="button"
                      data-adb-action="CHECK_KIOSK"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 text-[11px] transition"
                      title="Verifica se o Fully Kiosk Browser está instalado na Box"
                    >
                      🔍 Verificar Kiosk
                    </button>
                    <button
                      type="button"
                      data-adb-action="TOGGLE_WATCHDOG"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 text-[11px] transition"
                      title="Pausa ou retoma a supervisão automática de 12s"
                    >
                      ${b.autoWatchdog !== false ? '⏸️ Pausar Watchdog' : '▶️ Ativar Watchdog'}
                    </button>
                    <button
                      type="button"
                      data-adb-action="TAP_FULLSCREEN"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-[11px] transition"
                    >
                      ⛶ Fullscreen
                    </button>
                    <button
                      type="button"
                      data-adb-action="REBOOT_BOX"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/30 font-bold text-[11px] transition"
                    >
                      🔌 Reiniciar
                    </button>
                    <button
                      type="button"
                      data-adb-action="REMOVE_BOX"
                      data-adb-ip="${b.boxIp}"
                      class="px-2 py-1.5 rounded bg-slate-900 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-[11px] transition"
                      title="Remover Box do Watchdog"
                    >
                      ✕
                    </button>
                  </div>
                </div>
              `
              )
              .join('');

            document.querySelectorAll('[data-adb-action]').forEach((btn) => {
              btn.addEventListener('click', async () => {
                const action = btn.getAttribute('data-adb-action');
                const boxIp = btn.getAttribute('data-adb-ip');
                const playerUrl = btn.getAttribute('data-adb-url');
                const logBox = document.getElementById('adb-console-log');
                if (logBox) {
                  logBox.classList.remove('hidden');
                  logBox.textContent = `A executar comando ADB [${action}] na Box ${boxIp}:5555...`;
                }
                const res = await fetch(`${API_BASE}/api/v1/live/adb/action`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ boxIp, action, playerUrl }),
                });
                const data = await res.json().catch(() => ({}));
                if (logBox) {
                  logBox.textContent =
                    data.message ||
                    (action === 'REBOOT_BOX'
                      ? `✅ Comando de Reboot enviado para a Box ${boxIp}! Assim que a Box voltar a ligar (~30s), o Watchdog abrirá o Player automaticamente.`
                      : `✅ Comando [${action}] executado com sucesso na Box ${boxIp}!`);
                }
                refreshDevicesPage();
              });
            });
          }
        }

        // Filtra equipamentos pela INSÍGNIA ATIVA (FNAC ou DARTY)
        const selStore = storeFilterEl?.value || 'ALL';
        const selCat = catFilterEl?.value || 'ALL';

        const allDevs = (st.devices || []).filter((d) => {
          if (d.brand && d.brand !== activeBrand) return false;
          // Se o equipamento tiver loja atribuída, confirma que a loja é da marca ativa
          if (d.storeName) {
            const matchedStore = allStores.find((s) => s.name === d.storeName);
            if (matchedStore && matchedStore.brand && matchedStore.brand !== activeBrand) {
              return false;
            }
          }
          return true;
        });

        const filteredDevs = allDevs.filter((d) => {
          if (selCat !== 'ALL' && d.category !== selCat) return false;
          if (
            selStore !== 'ALL' &&
            d.storeName &&
            !d.storeName.toLowerCase().includes(selStore.toLowerCase())
          ) {
            return false;
          }
          return true;
        });

        const onlineCount = allDevs.filter((d) => d.status === 'ONLINE').length;
        const badgeEl = document.getElementById('dev-active-badge');
        if (badgeEl) {
          badgeEl.textContent = `${onlineCount}/${allDevs.length} Terminais (${activeBrand}) na LAN`;
        }

        const devList = document.getElementById('live-devices-list');
        if (filteredDevs.length === 0) {
          devList.innerHTML = `
            <div class="p-6 rounded-lg bg-slate-950 border border-dashed border-slate-800 text-center text-slate-400">
              Nenhum terminal ${activeBrand} encontrado com os filtros atuais (${selStore} / ${selCat}).
              <div class="mt-3">
                <button
                  type="button"
                  id="btn-empty-pair"
                  class="px-3 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-xs transition"
                >
                  ⚡ Emparelhar Novo Terminal
                </button>
              </div>
            </div>
          `;
          document.getElementById('btn-empty-pair')?.addEventListener('click', () => openPairingModal(true));
        } else {
          devList.innerHTML = filteredDevs
            .map(
              (d) => `
              <div class="p-4 rounded-xl bg-slate-950 border ${
                d.status === 'PENDING_APPROVAL' ? 'border-amber-400 ring-1 ring-amber-400' : 'border-slate-800'
              } flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="space-y-1.5">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="w-2.5 h-2.5 rounded-full ${
                      d.status === 'ONLINE'
                        ? 'bg-emerald-400'
                        : d.status === 'PENDING_APPROVAL'
                        ? 'bg-amber-400 animate-pulse'
                        : 'bg-rose-500'
                    }"></span>
                    <strong class="text-white text-sm">${d.name}</strong>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30">
                      ID: ${d.pairingCode || d.hardwareUid}
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-sky-300 border border-slate-700 font-semibold">${d.category}</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">${d.storeName || 'Loja Principal'}</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-emerald-300 border border-slate-800">${d.screenProfile || '16:9'}</span>
                    ${
                      d.invert180
                        ? `<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold">🔄 180° INVERTIDO</span>`
                        : ''
                    }
                    ${
                      d.securityAlert
                        ? `<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/50 font-bold animate-pulse">🚨 ALERTA MITM / ASSINATURA INVÁLIDA</span>`
                        : ''
                    }
                  </div>
                  <p class="text-xs font-mono text-slate-400">
                    ▶ Em exibição: <span class="text-emerald-300 font-semibold">${d.currentMediaTitle}</span> • Zona: <strong class="text-slate-300">${d.zone || 'ENTRANCE_LEDWALL'}</strong> • IP: <span class="text-sky-300">${d.clientIp || 'LAN'}</span> • Prioridade: <strong>${d.activePriority || 'NORMAL'}</strong>
                  </p>
                </div>
                <div class="flex items-center gap-2 shrink-0 flex-wrap">
                  ${
                    d.securityAlert
                      ? `<button
                          type="button"
                          data-reset-alert="${d.hardwareUid}"
                          class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition shadow animate-pulse"
                          title="Reconhecer e limpar alerta de segurança"
                        >
                          🛡️ Repor Alerta
                        </button>`
                      : ''
                  }
                  <button
                    type="button"
                    data-invert-device="${d.hardwareUid}"
                    data-invert-current="${d.invert180 ? '1' : '0'}"
                    class="px-3 py-1.5 rounded-lg ${
                      d.invert180
                        ? 'bg-amber-500 text-black font-black'
                        : 'bg-slate-900 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold'
                    } text-xs transition"
                    title="Inverter Ecrã 180° (Pernas para o ar) em Tempo Real"
                  >
                    🔄 ${d.invert180 ? '180° ON' : 'Inverter 180°'}
                  </button>
                  <button
                    type="button"
                    data-pick-device="${d.pairingCode || d.hardwareUid}"
                    data-pick-name="${d.name}"
                    data-pick-store="${d.storeName || ''}"
                    data-pick-zone="${d.zone || 'ENTRANCE_LEDWALL'}"
                    data-pick-cat="${d.category || 'ANDROID_BOX'}"
                    data-pick-profile="${d.screenProfile || '16:9'}"
                    data-pick-invert="${d.invert180 ? '1' : '0'}"
                    class="px-3 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-xs transition shadow"
                  >
                    ${d.status === 'PENDING_APPROVAL' ? '⚡ Emparelhar' : '✎ Configurar'}
                  </button>
                  <button
                    type="button"
                    data-remove-device="${d.hardwareUid}"
                    class="px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-xs transition"
                    title="Remover equipamento da lista"
                  >
                    ✕
                  </button>
                </div>
              </div>
            `
            )
            .join('');

          document.querySelectorAll('[data-invert-device]').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const hardwareUid = btn.getAttribute('data-invert-device');
              const isCur = btn.getAttribute('data-invert-current') === '1';
              await fetch(`${API_BASE}/api/v1/live/devices/invert`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hardwareUid, invert180: !isCur }),
              });
              refreshDevicesPage();
            });
          });

          document.querySelectorAll('[data-reset-alert]').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const hardwareUid = btn.getAttribute('data-reset-alert');
              await fetch(`${API_BASE}/api/v1/live/security/reset-alert`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hardwareUid }),
              });
              refreshDevicesPage();
            });
          });

          document.querySelectorAll('[data-pick-device]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const devName = btn.getAttribute('data-pick-name');
              if (pairingModalTitle) {
                pairingModalTitle.textContent = `Configurar Terminal: ${devName}`;
              }
              document.getElementById('pair-code').value = btn.getAttribute('data-pick-device');
              document.getElementById('pair-name').value = devName;
              const stName = btn.getAttribute('data-pick-store');
              if (stName) document.getElementById('pair-store').value = stName;
              const zn = btn.getAttribute('data-pick-zone');
              if (zn) document.getElementById('pair-zone').value = zn;
              const cat = btn.getAttribute('data-pick-cat');
              if (cat) document.getElementById('pair-category').value = cat;
              const prof = btn.getAttribute('data-pick-profile');
              if (prof) document.getElementById('pair-profile').value = prof;
              const inv = btn.getAttribute('data-pick-invert') === '1';
              const invEl = document.getElementById('pair-invert180');
              if (invEl) invEl.checked = inv;
              openPairingModal(false);
            });
          });

          document.querySelectorAll('[data-remove-device]').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const uid = btn.getAttribute('data-remove-device');
              await fetch(`${API_BASE}/api/v1/live/devices/${encodeURIComponent(uid)}`, {
                method: 'DELETE',
              });
              refreshDevicesPage();
            });
          });
        }
      } catch {
        // ignore
      }
    }

    const pairingForm = document.getElementById('pairing-form');
    const pairFeedback = document.getElementById('pair-feedback');

    pairingForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pairingCode = document.getElementById('pair-code').value;
      const name = document.getElementById('pair-name').value;
      const storeName = document.getElementById('pair-store').value;
      const zone = document.getElementById('pair-zone').value;
      const category = document.getElementById('pair-category').value;
      const screenProfile = document.getElementById('pair-profile')?.value || '16:9';
      const invert180 = document.getElementById('pair-invert180')?.checked || false;

      const res = await fetch(`${API_BASE}/api/v1/live/pairing/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          pairingCode,
          name,
          storeName,
          zone,
          category,
          screenProfile,
          invert180,
          brand: localStorage.getItem('invision_brand') || 'FNAC',
        }),
      });

      if (res.ok) {
        const data = await res.json();
        pairFeedback.classList.remove('hidden');
        pairFeedback.textContent = `✓ [GUARDADO VIA WEBSOCKET] Terminal "${data.device.name}" (${data.device.storeName} • ${data.device.category} • ${data.device.screenProfile}${data.device.invert180 ? ' • 🔄 180° Invertido' : ''}) atualizado com sucesso!`;
        refreshDevicesPage();
        setTimeout(() => {
          closePairingModal();
        }, 1200);
      }
    });

    const adbForm = document.getElementById('adb-provision-form');
    const adbLog = document.getElementById('adb-console-log');
    const adbSubmitBtn = document.getElementById('adb-submit-btn');

    adbForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const boxIp = document.getElementById('adb-box-ip').value.trim();
      const playerUrl = document.getElementById('adb-player-url').value.trim();

      if (adbLog) {
        adbLog.classList.remove('hidden');
        adbLog.textContent = `⏳ A ligar via ADB a ${boxIp}:5555 e a abrir ${playerUrl} na TV... (Aguarde ~4 segundos)`;
      }
      if (adbSubmitBtn) {
        adbSubmitBtn.disabled = true;
        adbSubmitBtn.textContent = '⏳ A Provisionar Box...';
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/live/adb/provision`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            boxIp,
            playerUrl,
            autoWatchdog: true,
          }),
        });
        const data = await res.json();
        if (adbLog) {
          adbLog.textContent = (data.logs || []).join('\n') + (data.error ? `\n❌ ${data.error}` : '');
        }
        refreshDevicesPage();
      } catch (err) {
        if (adbLog) {
          adbLog.textContent = `❌ Erro ao comunicar com o Backend ADB: ${err.message || err}`;
        }
      } finally {
        if (adbSubmitBtn) {
          adbSubmitBtn.disabled = false;
          adbSubmitBtn.textContent = '🚀 Provisionar Box';
        }
      }
    });

    refreshDevicesPage();
    setInterval(refreshDevicesPage, 3000);
  </script>
</DashboardLayout>
