---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="Biblioteca de Conteúdos & Media (Upload SHA-256, Format Guardrail & Smart TAGs)"
  activeNav="content"
>
  <!-- AVISO PARA PERFIS READ-ONLY -->
  <div
    id="readonly-warning"
    data-rbac-hide="GLOBAL_ADMIN,MEDIA_MANAGER"
    class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-sm text-rose-300"
  >
    <strong>Acesso Restrito (Governance RBAC):</strong> O perfil selecionado é Read-Only. Mude o seletor de perfil na barra lateral para <code>GLOBAL_ADMIN</code> ou <code>MEDIA_MANAGER</code> para carregar ficheiros e gerir TAGs.
  </div>

  <!-- 1. UPLOAD DE NOVOS CONTEÚDOS COM ATRIBUIÇÃO DE SMART TAGS -->
  <div
    data-rbac-hide="STORE_MANAGER,DEPT_HEAD,IT_OPS"
    class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8"
  >
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4 mb-5">
      <div>
        <span class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          1. Upload de Conteúdos • SHA-256 + Smart TAGs Auto-Binding
        </span>
        <h3 class="text-base font-bold text-white mt-1.5">
          Carregar Novos Vídeos (.mp4, .webm, .mov) ou Imagens (.jpg, .png, .webp)
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">
          Ao atribuir <strong>TAGs</strong> ao ficheiro (ex: <code>NATAL, CREDITO, GAMING</code>), o sistema associa-o <strong>automaticamente</strong> a todas as Playlists que tenham essas mesmas TAGs configuradas!
        </p>
      </div>
      <a
        href="/playlists/"
        class="px-3.5 py-2 rounded-lg bg-slate-950 hover:bg-slate-800 text-amber-300 border border-amber-500/30 text-xs font-bold transition shrink-0"
      >
        Ir para Playlists & Prioridades →
      </a>
    </div>

    <form id="upload-form" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">Ficheiro de Vídeo ou Imagem</label>
        <input
          type="file"
          id="media-file-input"
          accept="video/mp4,video/webm,video/quicktime,image/jpeg,image/png,image/webp"
          required
          class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-[#E1A924] file:text-black hover:file:bg-amber-400"
        />
      </div>

      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">Título da Campanha / Conteúdo</label>
        <input
          type="text"
          id="media-title-input"
          placeholder="Ex: Campanha Fnac Natal Kids"
          class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:border-amber-400 focus:outline-none"
        />
      </div>

      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">
          TAGs de Auto-Associação <span class="text-emerald-400 font-mono">(separadas por vírgula)</span>
        </label>
        <input
          type="text"
          id="media-tags-input"
          placeholder="Ex: NATAL, CREDITO, FLASH_SALE"
          class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono uppercase text-emerald-300 focus:border-amber-400 focus:outline-none"
        />
      </div>

      <div class="md:col-span-1">
        <label class="block text-xs text-slate-400 mb-1">Duração (s)</label>
        <input
          type="number"
          id="media-duration-input"
          value="8"
          min="2"
          max="120"
          class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-2 text-xs text-amber-300 font-mono"
        />
      </div>

      <div class="md:col-span-2">
        <button
          type="submit"
          class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-black text-xs py-2.5 px-4 rounded-lg shadow transition"
        >
          ⬆ Carregar Media
        </button>
      </div>
    </form>

    <!-- Sugestões Rápidas de TAGs existentes nas Playlists -->
    <div class="mt-3 flex items-center gap-2 flex-wrap">
      <span class="text-[11px] text-slate-400 font-mono">Clique para adicionar TAG rápida:</span>
      <div id="quick-tag-pills" class="flex items-center gap-1.5 flex-wrap"></div>
    </div>

    <div
      id="upload-status"
      class="hidden mt-4 p-3 rounded-lg bg-slate-950 border border-slate-700 text-xs font-mono text-emerald-300"
    ></div>
  </div>

  <!-- 2. BIBLIOTECA DE CONTEÚDOS GUARDADOS (FILTRO POR TAG, EDIÇÃO DE TAGS & ENVIO P/ PLAYLIST) -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-800 pb-4 mb-5">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          2. Catálogo Central de Conteúdos & Gestão de TAGs
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">
          Pode editar as TAGs de qualquer vídeo ou imagem já carregado para que ele entre automaticamente nas Playlists com a mesma TAG.
        </p>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <select
          id="filter-tag-select"
          class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono text-emerald-300"
        >
          <option value="ALL">🏷️ Filtrar por TAG: Todas</option>
        </select>

        <input
          type="search"
          id="search-media-input"
          placeholder="Pesquisar título ou TAG..."
          class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-400 focus:outline-none w-52"
        />
      </div>
    </div>

    <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </div>

  <script is:inline>
    const API_BASE = `${window.location.protocol}//${window.location.hostname}:3000`;

    const uploadForm = document.getElementById('upload-form');
    const fileInput = document.getElementById('media-file-input');
    const titleInput = document.getElementById('media-title-input');
    const tagsInput = document.getElementById('media-tags-input');
    const durationInput = document.getElementById('media-duration-input');
    const uploadStatus = document.getElementById('upload-status');
    const catalogGrid = document.getElementById('catalog-grid');
    const quickTagPills = document.getElementById('quick-tag-pills');
    const filterTagSelect = document.getElementById('filter-tag-select');
    const searchMediaInput = document.getElementById('search-media-input');

    let liveState = {
      brand: 'FNAC',
      mediaCatalog: [],
      playlists: [],
    };

    function gcd(a, b) {
      return b === 0 ? a : gcd(b, a % b);
    }

    function calcAspectRatio(w, h) {
      if (!w || !h) return '16:9';
      const r = w / h;
      if (Math.abs(r - 16 / 9) < 0.08) return '16:9';
      if (Math.abs(r - 9 / 16) < 0.08) return '9:16';
      if (Math.abs(r - 32 / 9) < 0.15) return '32:9';
      const d = gcd(w, h);
      return `${Math.round(w / d)}:${Math.round(h / d)}`;
    }

    function inspectLocalFile(file) {
      return new Promise((resolve) => {
        const objectUrl = URL.createObjectURL(file);
        if (file.type.startsWith('image/')) {
          const img = new Image();
          img.onload = () => {
            const w = img.naturalWidth || 1920;
            const h = img.naturalHeight || 1080;
            URL.revokeObjectURL(objectUrl);
            resolve({
              width: w,
              height: h,
              ratio: calcAspectRatio(w, h),
              durationMs: (parseInt(durationInput.value, 10) || 8) * 1000,
            });
          };
          img.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            resolve({ width: 1920, height: 1080, ratio: '16:9', durationMs: 8000 });
          };
          img.src = objectUrl;
        } else {
          const video = document.createElement('video');
          video.preload = 'metadata';
          video.onloadedmetadata = () => {
            const w = video.videoWidth || 1920;
            const h = video.videoHeight || 1080;
            const durMs = Math.max(2000, Math.round((video.duration || 10) * 1000));
            URL.revokeObjectURL(objectUrl);
            resolve({
              width: w,
              height: h,
              ratio: calcAspectRatio(w, h),
              durationMs: durMs,
            });
          };
          video.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            resolve({ width: 1920, height: 1080, ratio: '16:9', durationMs: 10000 });
          };
          video.src = objectUrl;
        }
      });
    }

    async function fetchContentState() {
      const res = await fetch(`${API_BASE}/api/v1/live/state`);
      liveState = await res.json();
      renderContentLibrary();
    }

    function renderContentLibrary() {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const allPlaylists = liveState.playlists || [];

      // Recolhe todas as TAGs usadas nas Playlists e nos Conteúdos
      const allKnownTags = new Set(['NATAL', 'CREDITO', 'FLASH_SALE', 'GAMING', 'NORMAL', 'INSTITUCIONAL']);
      allPlaylists.forEach((pl) => (pl.autoTags || []).forEach((t) => allKnownTags.add(t)));
      (liveState.mediaCatalog || []).forEach((m) => (m.tags || []).forEach((t) => allKnownTags.add(t)));

      // Renderiza botões rápidos de TAGs
      if (quickTagPills) {
        quickTagPills.innerHTML = Array.from(allKnownTags)
          .map(
            (t) => `
            <button
              type="button"
              data-quick-tag="${t}"
              class="px-2 py-0.5 rounded bg-slate-950 hover:bg-emerald-500/20 text-emerald-300 border border-slate-700 text-[10px] font-mono transition"
            >
              +${t}
            </button>
          `
          )
          .join('');

        document.querySelectorAll('[data-quick-tag]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const tag = btn.getAttribute('data-quick-tag');
            const current = tagsInput.value
              .split(',')
              .map((s) => s.trim().toUpperCase())
              .filter(Boolean);
            if (!current.includes(tag)) current.push(tag);
            tagsInput.value = current.join(', ');
          });
        });
      }

      // Atualiza select de filtro por TAG
      const prevSelectedTag = filterTagSelect?.value || 'ALL';
      if (filterTagSelect) {
        filterTagSelect.innerHTML =
          `<option value="ALL">🏷️ Filtrar por TAG: Todas (${allKnownTags.size})</option>` +
          Array.from(allKnownTags)
            .map((t) => `<option value="${t}">🏷️ TAG: ${t}</option>`)
            .join('');
        filterTagSelect.value = Array.from(allKnownTags).includes(prevSelectedTag)
          ? prevSelectedTag
          : 'ALL';
      }

      const tagFilter = filterTagSelect?.value || 'ALL';
      const searchQ = (searchMediaInput?.value || '').trim().toLowerCase();

      const filteredCatalog = (liveState.mediaCatalog || []).filter((m) => {
        if (activeBrand !== 'ALL' && m.brand !== activeBrand) return false;
        const mTags = Array.isArray(m.tags) ? m.tags : [];
        if (tagFilter !== 'ALL' && !mTags.includes(tagFilter)) return false;
        if (
          searchQ &&
          !m.title.toLowerCase().includes(searchQ) &&
          !mTags.join(' ').toLowerCase().includes(searchQ)
        ) {
          return false;
        }
        return true;
      });

      if (filteredCatalog.length === 0) {
        catalogGrid.innerHTML = `
          <div class="md:col-span-3 p-8 rounded-xl bg-slate-950 border border-dashed border-slate-700 text-center text-xs text-slate-400">
            Nenhum ficheiro encontrado para os filtros atuais. Carregue vídeos ou imagens no topo desta página!
          </div>
        `;
        return;
      }

      catalogGrid.innerHTML = filteredCatalog
        .map((asset) => {
          const streamFullUrl = `${API_BASE}${asset.streamUrl}`;
          const assetTags = Array.isArray(asset.tags) ? asset.tags : [];
          const previewHtml =
            asset.mediaType === 'IMAGE'
              ? `<img src="${streamFullUrl}" alt="${asset.title}" class="w-full h-36 object-cover rounded-lg border border-slate-800 bg-black" />`
              : `<video src="${streamFullUrl}" muted loop playsinline onmouseover="this.play()" onmouseout="this.pause()" class="w-full h-36 object-cover rounded-lg border border-slate-800 bg-black"></video>`;

          // Verifica em que Playlists este ficheiro está presente
          const matchingPlaylists = allPlaylists.filter((pl) =>
            (pl.items || []).some((it) => it.id === asset.id)
          );

          const tagsBadges =
            assetTags.length > 0
              ? assetTags
                  .map(
                    (t) =>
                      `<span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-[10px] font-mono font-bold">#${t}</span>`
                  )
                  .join(' ')
              : `<span class="text-[10px] font-mono text-slate-500">Sem TAGs atribuídas</span>`;

          const playlistsBadges =
            matchingPlaylists.length > 0
              ? matchingPlaylists
                  .map(
                    (pl) =>
                      `<span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px] font-mono">🎞️ ${pl.name}</span>`
                  )
                  .join(' ')
              : `<span class="text-[10px] font-mono text-slate-500">Não atribuído a nenhuma Playlist</span>`;

          return `
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col justify-between gap-3">
              <div>
                ${previewHtml}
                <div class="flex items-center justify-between mt-3">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded ${
                    asset.brand === 'DARTY' ? 'bg-[#E30613] text-white' : 'bg-[#E1A924] text-black'
                  }">${asset.brand} • ${asset.mediaType}</span>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-emerald-300">
                    ${asset.widthPx}x${asset.heightPx} (${asset.aspectRatio}) • ${(asset.durationMs / 1000).toFixed(0)}s
                  </span>
                </div>

                <h4 class="text-sm font-bold text-white mt-2 truncate" title="${asset.title}">${asset.title}</h4>

                <div class="mt-2 flex flex-wrap gap-1">
                  ${tagsBadges}
                </div>

                <div class="mt-2 pt-2 border-t border-slate-900">
                  <span class="block text-[10px] uppercase font-mono text-slate-400 mb-1">Presente nas Playlists:</span>
                  <div class="flex flex-wrap gap-1">
                    ${playlistsBadges}
                  </div>
                </div>
              </div>

              <!-- Editor Rápido de TAGs do Ficheiro -->
              <div class="pt-2 border-t border-slate-800 space-y-2">
                <div class="flex gap-1.5">
                  <input
                    type="text"
                    data-tag-input-for="${asset.id}"
                    value="${assetTags.join(', ')}"
                    placeholder="TAGs: ex. NATAL, CREDITO"
                    class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] font-mono uppercase text-emerald-300 focus:border-amber-400 focus:outline-none"
                  />
                  <button
                    type="button"
                    data-save-tags="${asset.id}"
                    class="px-2.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold transition"
                  >
                    Guardar TAGs
                  </button>
                </div>

                <div class="flex items-center justify-between gap-2">
                  <select
                    data-manual-pl-for="${asset.id}"
                    class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-[11px] text-slate-200"
                  >
                    ${allPlaylists
                      .map((pl) => `<option value="${pl.id}">+ Enviar p/ ${pl.name}</option>`)
                      .join('')}
                  </select>
                  <button
                    type="button"
                    data-send-to-pl="${asset.id}"
                    class="px-2.5 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-[11px] transition"
                  >
                    Inserir
                  </button>
                  <button
                    type="button"
                    data-del-media="${asset.id}"
                    class="px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-rose-500/20 text-rose-400 border border-slate-800 text-[11px] transition"
                    title="Apagar ficheiro do servidor"
                  >
                    ✕
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join('');

      // Eventos Guardar TAGs
      document.querySelectorAll('[data-save-tags]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-save-tags');
          const inp = document.querySelector(`[data-tag-input-for="${id}"]`);
          const tags = inp ? inp.value : '';
          await fetch(`${API_BASE}/api/v1/live/media/${id}/tags`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tags }),
          });
          await fetchContentState();
        });
      });

      // Eventos Enviar Manualmente para Playlist
      document.querySelectorAll('[data-send-to-pl]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-send-to-pl');
          const sel = document.querySelector(`[data-manual-pl-for="${id}"]`);
          const plId = sel ? sel.value : null;
          const asset = liveState.mediaCatalog.find((a) => a.id === id);
          const pl = liveState.playlists.find((p) => p.id === plId);
          if (!asset || !pl) return;
          if (!Array.isArray(pl.items)) pl.items = [];
          pl.items.push({ ...asset, sovPct: 50 });

          await fetch(`${API_BASE}/api/v1/live/playlists`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              brand: liveState.brand,
              playlists: liveState.playlists,
            }),
          });
          await fetchContentState();
        });
      });

      // Eventos Apagar Ficheiro
      document.querySelectorAll('[data-del-media]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-del-media');
          await fetch(`${API_BASE}/api/v1/live/media/${id}`, { method: 'DELETE' });
          await fetchContentState();
        });
      });
    }

    uploadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const file = fileInput.files?.[0];
      if (!file) return;

      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const brandToSave = activeBrand === 'ALL' ? 'FNAC' : activeBrand;
      const customTitle = titleInput.value.trim() || file.name;
      const customTags = tagsInput.value.trim();

      uploadStatus.classList.remove('hidden');
      uploadStatus.textContent = `A inspecionar "${file.name}"...`;

      const meta = await inspectLocalFile(file);
      uploadStatus.textContent = `A enviar "${customTitle}" (${meta.width}x${meta.height} • ${meta.ratio}) com TAGs [${customTags || 'Nenhuma'}]...`;

      const query = new URLSearchParams({
        filename: file.name,
        title: customTitle,
        brand: brandToSave,
        mime: file.type || 'video/mp4',
        width: String(meta.width),
        height: String(meta.height),
        ratio: meta.ratio,
        duration_ms: String(meta.durationMs),
        tags: customTags,
      });

      const res = await fetch(`${API_BASE}/api/v1/live/upload?${query.toString()}`, {
        method: 'POST',
        body: file,
      });

      if (res.ok) {
        const created = await res.json();
        uploadStatus.textContent =
          created.tags && created.tags.length > 0
            ? `✓ Upload concluído! O conteúdo "${created.title}" foi associado automaticamente a todas as Playlists com a(s) TAG(s): ${created.tags.join(', ')}!`
            : `✓ Upload concluído e guardado na Biblioteca de Conteúdos!`;
        uploadForm.reset();
        durationInput.value = '8';
        await fetchContentState();
      }
    });

    filterTagSelect?.addEventListener('change', renderContentLibrary);
    searchMediaInput?.addEventListener('input', renderContentLibrary);
    window.addEventListener('invision:brand-change', renderContentLibrary);
    fetchContentState();
  </script>
</DashboardLayout>
