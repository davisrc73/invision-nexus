  <script is:inline>
    const API_BASE = `${window.location.protocol}//${window.location.hostname}:3000`;
    let latestState = { popRecords: [], popAuditLogs: [], interactionRecords: [], storesCatalog: [] };

    const KNOWN_COMMERCIAL_BRANDS = [
      'Samsung',
      'Apple',
      'Sony',
      'LG',
      'Dyson',
      'Philips',
      'Whirlpool',
      'DeLonghi',
      'Bose',
      'Microsoft',
      'Asus',
      'Lenovo',
      'HP',
      'Canon',
      'Nikon',
      'Xiaomi',
      'Tefal',
      'Rowenta',
      'Nespresso',
      'Google',
      'Huawei',
      'JBL',
      'TCL',
      'Hisense',
      'Braun',
      'Sennheiser',
      'Garmin',
      'Logitech',
    ];

    function isCommercialRetailMedia(partner = '', title = '') {
      const pUpper = (partner || '').toUpperCase();
      const tUpper = (title || '').toUpperCase();

      for (const b of KNOWN_COMMERCIAL_BRANDS) {
        const bUpper = b.toUpperCase();
        if (pUpper.includes(bUpper) || tUpper.includes(bUpper)) {
          return true;
        }
      }

      if (
        pUpper.includes('EDITORIAL') ||
        pUpper.includes('GERAL') ||
        pUpper.includes('CRÉDITO') ||
        pUpper.includes('CREDITO') ||
        pUpper.includes('BLACK FRIDAY') ||
        pUpper.includes('INSTITUCIONAL') ||
        pUpper.includes('FALLBACK') ||
        pUpper.includes('AVISO') ||
        pUpper.includes('SERVIÇOS') ||
        pUpper.includes('SERVICOS')
      ) {
        return false;
      }
      return false;
    }

    // Filtros selecionados (Por padrão, foca em Retail Media comercial)
    let selectedStore = 'ALL';
    let selectedPartner = 'RETAIL_MEDIA_ONLY';
    let selectedPeriod = 'REALTIME';

    async function refreshTelemetryPage() {
      try {
        const res = await fetch(`${API_BASE}/api/v1/live/state`);
        latestState = await res.json();
        syncPolicyDropdown();
        populateStoreDropdown();
        renderCommercialTelemetry();
      } catch {
        // ignore
      }
    }

    function syncPolicyDropdown() {
      const select = document.getElementById('select-pop-policy');
      const dot = document.getElementById('pop-policy-dot');
      if (!select) return;
      const policy = latestState.telemetryAuditPolicy || latestState.storageMetrics?.telemetryAuditPolicy || 'RETAIL_MEDIA_ONLY';
      if (select.value !== policy) {
        select.value = policy;
      }
      if (dot) {
        if (policy === 'RETAIL_MEDIA_ONLY') {
          dot.className = 'inline-block w-2 h-2 rounded-full bg-emerald-400';
        } else if (policy === 'FULL_AUDIT') {
          dot.className = 'inline-block w-2 h-2 rounded-full bg-sky-400';
        } else {
          dot.className = 'inline-block w-2 h-2 rounded-full bg-amber-400';
        }
      }
    }

    function populateStoreDropdown() {
      const select = document.getElementById('filter-store');
      if (!select) return;
      const currentVal = select.value;
      const stores = (latestState.storesCatalog || []);
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const filteredStores = stores.filter((s) => !s.brand || s.brand === activeBrand);

      // Mantém a opção "ALL" e adiciona as lojas reais
      let optionsHtml = '<option value="ALL">Todas as Lojas</option>';
      filteredStores.forEach((s) => {
        optionsHtml += `<option value="${s.name}">${s.name} (${s.region || 'Geral'})</option>`;
      });

      if (select.children.length !== filteredStores.length + 1) {
        select.innerHTML = optionsHtml;
        select.value = currentVal || 'ALL';
      }
    }

    function formatDuration(ms) {
      const totalSec = Math.floor(ms / 1000);
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      if (h > 0) return `${h}h ${m}m ${s}s`;
      if (m > 0) return `${m}m ${s}s`;
      return `${s}s`;
    }

    function renderCommercialTelemetry() {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';

      // Atualiza badge de insígnia
      const brandBadge = document.getElementById('telemetry-brand-badge');
      if (brandBadge) {
        brandBadge.textContent = `Marca Ativa: ${activeBrand}`;
        brandBadge.className =
          activeBrand === 'DARTY'
            ? 'text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-red-500/20 text-red-300 font-bold border border-red-500/40'
            : 'text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-500/40';
      }

      // 1. Filtra registos pela marca ativa e filtros selecionados
      const allPop = latestState.popRecords || [];
      const filteredPop = allPop.filter((r) => {
        if (r.brand && r.brand !== activeBrand) return false;
        if (selectedStore !== 'ALL' && r.storeName && r.storeName !== selectedStore) return false;
        if (selectedPartner === 'RETAIL_MEDIA_ONLY') {
          return isCommercialRetailMedia(r.partner, r.mediaTitle);
        }
        if (selectedPartner === 'NON_COMMERCIAL') {
          return !isCommercialRetailMedia(r.partner, r.mediaTitle);
        }
        if (selectedPartner !== 'ALL' && r.partner && r.partner !== selectedPartner) return false;
        return true;
      });

      // 2. Calcula KPIs Comerciais
      const totalPlays = filteredPop.reduce((acc, r) => acc + (r.playCount || 0), 0);
      const totalDurationMs = filteredPop.reduce((acc, r) => acc + (r.totalDurationMs || 0), 0);

      const kpiPlaysEl = document.getElementById('kpi-total-plays');
      if (kpiPlaysEl) kpiPlaysEl.textContent = `${totalPlays.toLocaleString('pt-PT')} Plays`;

      const kpiAirtimeEl = document.getElementById('kpi-total-airtime');
      if (kpiAirtimeEl) kpiAirtimeEl.textContent = formatDuration(totalDurationMs);

      // Agregação por parceiro comercial para calcular SoV Real
      const partnerStats = {};
      filteredPop.forEach((r) => {
        const p = r.partner || 'Campanha Geral';
        if (!partnerStats[p]) {
          partnerStats[p] = {
            partner: p,
            plays: 0,
            durationMs: 0,
            contractedSov: r.contractedSovPct || 25,
            campaigns: new Set(),
            stores: new Set(),
          };
        }
        partnerStats[p].plays += r.playCount || 0;
        partnerStats[p].durationMs += r.totalDurationMs || 0;
        partnerStats[p].campaigns.add(r.mediaTitle);
        if (r.storeName) partnerStats[p].stores.add(r.storeName);
      });

      // Determina Parceiro Líder
      let topPartner = null;
      let maxDuration = 0;
      Object.values(partnerStats).forEach((p) => {
        if (p.durationMs > maxDuration) {
          maxDuration = p.durationMs;
          topPartner = p;
        }
      });

      const topPartnerEl = document.getElementById('kpi-top-partner');
      const topPartnerStatsEl = document.getElementById('kpi-top-partner-stats');
      if (topPartnerEl && topPartnerStatsEl) {
        if (topPartner && totalDurationMs > 0) {
          const pct = ((topPartner.durationMs / totalDurationMs) * 100).toFixed(1);
          topPartnerEl.textContent = topPartner.partner;
          topPartnerStatsEl.textContent = `${topPartner.plays} plays • ${pct}% do ar total`;
        } else {
          topPartnerEl.textContent = '-';
          topPartnerStatsEl.textContent = 'A aguardar dados';
        }
      }

      // Calcula Cumprimento Médio de SoV
      const partnerList = Object.values(partnerStats);
      let avgCompliance = 100;
      if (partnerList.length > 0 && totalDurationMs > 0) {
        let sumCompliance = 0;
        partnerList.forEach((p) => {
          const actualSov = (p.durationMs / totalDurationMs) * 100;
          const compliance = Math.min(125, (actualSov / (p.contractedSov || 25)) * 100);
          sumCompliance += compliance;
        });
        avgCompliance = (sumCompliance / partnerList.length).toFixed(1);
      }

      const avgSovEl = document.getElementById('kpi-avg-sov');
      const sovStatusEl = document.getElementById('kpi-sov-status');
      if (avgSovEl && sovStatusEl) {
        avgSovEl.textContent = `${avgCompliance}%`;
        if (avgCompliance >= 98) {
          sovStatusEl.textContent = '● CONFORME SLA';
          sovStatusEl.className = 'text-emerald-400 font-bold';
        } else if (avgCompliance >= 90) {
          sovStatusEl.textContent = '● NO LIMIAR';
          sovStatusEl.className = 'text-amber-400 font-bold';
        } else {
          sovStatusEl.textContent = '● DÉFICE DE EXIBIÇÃO';
          sovStatusEl.className = 'text-rose-400 font-bold';
        }
      }

      // Atualiza KPI 5: Pegada de Armazenamento & Base de Dados
      const storage = latestState.storageMetrics || {};
      const storageSizeEl = document.getElementById('kpi-storage-size');
      const storageBadgeEl = document.getElementById('kpi-storage-badge');
      const storageRecordsEl = document.getElementById('kpi-storage-records');
      const policyBadgeEl = document.getElementById('kpi-policy-badge');
      const storageEstimateEl = document.getElementById('kpi-storage-estimate');

      if (storageSizeEl) {
        storageSizeEl.textContent = storage.stateFileSizeFormatted || '19.4 KB';
      }
      if (storageRecordsEl) {
        const totalRecs =
          storage.totalTelemetryRecords !== undefined
            ? storage.totalTelemetryRecords
            : allPop.length + (latestState.popAuditLogs || []).length;
        storageRecordsEl.textContent = `${totalRecs.toLocaleString('pt-PT')} registos`;
      }
      if (storageBadgeEl) {
        if (storage.storageStatus === 'CRITICAL') {
          storageBadgeEl.textContent = '● CRÍTICO';
          storageBadgeEl.className = 'text-rose-400 font-bold text-[10px] font-mono';
        } else if (storage.storageStatus === 'WARNING') {
          storageBadgeEl.textContent = '● ATENÇÃO';
          storageBadgeEl.className = 'text-amber-400 font-bold text-[10px] font-mono';
        } else {
          storageBadgeEl.textContent = '● OTIMIZADO';
          storageBadgeEl.className = 'text-emerald-400 font-bold text-[10px] font-mono';
        }
      }

      const activePolicy = latestState.telemetryAuditPolicy || storage.telemetryAuditPolicy || 'RETAIL_MEDIA_ONLY';
      if (policyBadgeEl) {
        if (activePolicy === 'RETAIL_MEDIA_ONLY') {
          policyBadgeEl.textContent = '💎 RETAIL MEDIA';
          policyBadgeEl.className = 'font-mono text-emerald-400 font-semibold text-[10px]';
        } else if (activePolicy === 'FULL_AUDIT') {
          policyBadgeEl.textContent = '🔍 AUDITORIA 100%';
          policyBadgeEl.className = 'font-mono text-sky-400 font-semibold text-[10px]';
        } else {
          policyBadgeEl.textContent = '⏸️ PAUSADA';
          policyBadgeEl.className = 'font-mono text-amber-400 font-semibold text-[10px]';
        }
      }
      if (storageEstimateEl) {
        storageEstimateEl.textContent = storage.dailyGrowthEstimate || '~75% poupado em disco';
      }

      // Atualiza também os indicadores de espaço no Modal de Purga
      const purgeSizeEl = document.getElementById('purge-modal-size');
      const purgeRecordsEl = document.getElementById('purge-modal-records');
      if (purgeSizeEl) {
        purgeSizeEl.textContent = storage.stateFileSizeFormatted || '19.4 KB';
      }
      if (purgeRecordsEl) {
        const totalRecs =
          storage.totalTelemetryRecords !== undefined
            ? storage.totalTelemetryRecords
            : allPop.length + (latestState.popAuditLogs || []).length;
        purgeRecordsEl.textContent = `${totalRecs.toLocaleString('pt-PT')} registos`;
      }

      // 3. Renderiza Tabela 1: Matriz de Share of Voice
      const sovMatrixBody = document.getElementById('sov-matrix-body');
      if (sovMatrixBody) {
        if (filteredPop.length === 0) {
          sovMatrixBody.innerHTML = `
            <tr>
              <td colspan="9" class="py-6 px-3 text-slate-400 text-center font-mono">
                A aguardar exibição de conteúdos no leitor da marca <strong>${activeBrand}</strong>...
              </td>
            </tr>
          `;
        } else {
          sovMatrixBody.innerHTML = filteredPop
            .map((r) => {
              const contracted = r.contractedSovPct || (r.priority === 'EXCLUSIVA' ? 50 : 25);
              const actualSov = totalDurationMs > 0 ? ((r.totalDurationMs / totalDurationMs) * 100).toFixed(1) : '0.0';
              const compliance = Number(contracted) > 0 ? ((Number(actualSov) / Number(contracted)) * 100).toFixed(1) : '100.0';

              const isCompliant = Number(compliance) >= 95;
              const isWarning = Number(compliance) >= 85 && !isCompliant;

              return `
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="py-3 px-3 font-bold text-white flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full ${
                      r.partner?.includes('Samsung')
                        ? 'bg-sky-400'
                        : r.partner?.includes('Apple')
                        ? 'bg-slate-300'
                        : r.partner?.includes('Sony')
                        ? 'bg-indigo-400'
                        : r.partner?.includes('Dyson')
                        ? 'bg-purple-400'
                        : 'bg-amber-400'
                    }"></span>
                    <span>${r.partner || 'Campanha Geral'}</span>
                  </td>
                  <td class="py-3 px-3 font-medium text-slate-200">
                    ${r.mediaTitle}
                    <span class="block text-[10px] text-slate-400 font-mono">${r.playlistName}</span>
                  </td>
                  <td class="py-3 px-3 text-slate-300 font-mono text-[11px]">
                    ${r.storeName || 'Loja Principal'}
                    <span class="block text-[10px] text-slate-500">${r.zone || 'ENTRANCE_LEDWALL'}</span>
                  </td>
                  <td class="py-3 px-3 text-center font-mono font-bold text-slate-300">${contracted}%</td>
                  <td class="py-3 px-3 text-center font-mono font-bold ${
                    isCompliant ? 'text-emerald-400' : isWarning ? 'text-amber-300' : 'text-rose-400'
                  }">${actualSov}%</td>
                  <td class="py-3 px-3">
                    <div class="flex items-center gap-2">
                      <div class="w-full bg-slate-950 rounded-full h-2 overflow-hidden border border-slate-800">
                        <div class="h-2 rounded-full ${
                          isCompliant ? 'bg-emerald-400' : isWarning ? 'bg-amber-400' : 'bg-rose-500'
                        }" style="width: ${Math.min(100, compliance)}%"></div>
                      </div>
                      <span class="text-[10px] font-mono font-bold ${
                        isCompliant ? 'text-emerald-400' : isWarning ? 'text-amber-400' : 'text-rose-400'
                      }">${compliance}%</span>
                    </div>
                  </td>
                  <td class="py-3 px-3 text-right font-mono font-bold text-white">${r.playCount}</td>
                  <td class="py-3 px-3 text-right font-mono text-emerald-400 font-semibold">${formatDuration(r.totalDurationMs)}</td>
                  <td class="py-3 px-3 text-center">
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold ${
                      isCompliant
                        ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
                        : isWarning
                        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
                        : 'bg-rose-500/20 text-rose-300 border border-rose-500/30'
                    }">
                      ${isCompliant ? '✅ APROVADO' : isWarning ? '⏳ EM CURSO' : '⚠️ EM DÉFICE'}
                    </span>
                  </td>
                </tr>
              `;
            })
            .join('');
        }
      }

      // 4. Renderiza Tabela 2: Fita Forense de Proof of Play
      const popLogBody = document.getElementById('pop-log-body');
      if (popLogBody) {
        const auditLogs = (latestState.popAuditLogs || []).filter((l) => {
          if (l.brand && l.brand !== activeBrand) return false;
          if (selectedStore !== 'ALL' && l.storeName && l.storeName !== selectedStore) return false;
          if (selectedPartner === 'RETAIL_MEDIA_ONLY') {
            return isCommercialRetailMedia(l.partner, l.mediaTitle);
          }
          if (selectedPartner === 'NON_COMMERCIAL') {
            return !isCommercialRetailMedia(l.partner, l.mediaTitle);
          }
          if (selectedPartner !== 'ALL' && l.partner && l.partner !== selectedPartner) return false;
          return true;
        });

        if (auditLogs.length === 0) {
          popLogBody.innerHTML = `
            <tr>
              <td colspan="8" class="py-6 px-3 text-slate-400 text-center font-mono">
                A aguardar os próximos eventos de conclusão de vídeo/imagem nos ecrãs...
              </td>
            </tr>
          `;
        } else {
          popLogBody.innerHTML = auditLogs
            .slice(0, 30)
            .map((l) => {
              const d = new Date(l.timestamp);
              const timeStr = `${d.toLocaleDateString('pt-PT')} ${d.toLocaleTimeString('pt-PT')}`;
              return `
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="py-2.5 px-3 font-mono text-[11px] text-slate-400">${timeStr}</td>
                  <td class="py-2.5 px-3 text-slate-300 font-medium">${l.storeName || 'Loja Principal'}</td>
                  <td class="py-2.5 px-3 font-mono text-[11px] text-sky-300 font-semibold">${l.deviceName}</td>
                  <td class="py-2.5 px-3 font-bold text-white">${l.partner}</td>
                  <td class="py-2.5 px-3 font-medium text-slate-200">${l.mediaTitle}</td>
                  <td class="py-2.5 px-3 text-slate-400 font-mono text-[10px]">${l.priority}</td>
                  <td class="py-2.5 px-3 text-right font-mono text-emerald-400 font-bold">${(l.durationMs / 1000).toFixed(1)}s</td>
                  <td class="py-2.5 px-3 text-center">
                    <span class="px-1.5 py-0.5 rounded bg-slate-950 border border-slate-800 text-[10px] font-mono text-slate-400 font-bold" title="Hash criptográfico verificado">${l.sha256 || 'SHA-256 OK'}</span>
                  </td>
                </tr>
              `;
            })
            .join('');
        }
      }

      // 5. Renderiza Tabela 3: Interações Touch & TV Demo
      const intContainer = document.getElementById('interactions-list');
      const intRecords = latestState.interactionRecords || [];

      if (intRecords.length === 0) {
        intContainer.innerHTML = `
          <div class="col-span-full p-5 rounded-xl bg-slate-950 border border-dashed border-slate-800 text-center text-slate-400 font-mono text-xs">
            Para testar interações reais: abra o menu OSD no Player (tecla "i" ou 5 cliques no canto superior esquerdo), ative <strong>IDLE_SCREENSAVER</strong> ou <strong>INTERACTIVE_CATALOG (TV Demo)</strong> e toque no ecrã.
          </div>
        `;
      } else {
        intContainer.innerHTML = intRecords
          .map(
            (r) => `
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-bold">
                  ${r.interactionType}
                </span>
                <p class="font-bold text-white mt-1.5">${r.referenceKey}</p>
                <p class="text-slate-400 text-[11px]">Último toque: ${new Date(r.lastAt).toLocaleTimeString('pt-PT')}</p>
              </div>
              <div class="text-right font-mono">
                <span class="text-base font-black text-amber-300">${r.count}x</span>
                <p class="text-[11px] text-emerald-400 font-semibold">${r.totalSeconds}s envolvimento</p>
              </div>
            </div>
          `
          )
          .join('');
      }

      // 6. Atualiza dados do Certificado de Impressão e Modal de Pré-visualização
      const certBrandEl = document.getElementById('cert-brand-name');
      const certPlaysEl = document.getElementById('cert-total-plays');
      const certAirtimeEl = document.getElementById('cert-total-airtime');
      const certCompanyEl = document.getElementById('cert-company-title');
      const certTableEl = document.getElementById('cert-table-container');

      const modalBrandEl = document.getElementById('modal-cert-brand-name');
      const modalPlaysEl = document.getElementById('modal-cert-total-plays');
      const modalAirtimeEl = document.getElementById('modal-cert-total-airtime');
      const modalCompanyEl = document.getElementById('modal-cert-company-title');
      const modalTableEl = document.getElementById('modal-cert-table-container');

      const companyText = activeBrand === 'DARTY' ? 'DARTY (GROUPE FNAC DARTY)' : 'FNAC PORTUGAL / FRANÇA';

      // Filtra registos a incluir no Certificado Oficial de Faturação
      // Quando filtrado por Retail Media (ou por defeito), preserva estritamente campanhas comerciais para clientes
      const certRows = filteredPop.filter((r) => {
        if (selectedPartner !== 'ALL' && selectedPartner !== 'RETAIL_MEDIA_ONLY') {
          return true;
        }
        return isCommercialRetailMedia(r.partner, r.mediaTitle);
      });

      // Se houver campanhas de marcas comerciais, usa exclusivamente essas no certificado
      const targetCertPop = certRows.length > 0 ? certRows : filteredPop;
      const certTotalDurationMs = targetCertPop.reduce((acc, r) => acc + (r.totalDurationMs || 0), 0);
      const certTotalPlays = targetCertPop.reduce((acc, r) => acc + (r.playCount || 0), 0);

      const playsText = `${certTotalPlays.toLocaleString('pt-PT')} Plays`;
      const airtimeText = formatDuration(certTotalDurationMs);

      if (certBrandEl) certBrandEl.textContent = activeBrand;
      if (certPlaysEl) certPlaysEl.textContent = playsText;
      if (certAirtimeEl) certAirtimeEl.textContent = airtimeText;
      if (certCompanyEl) certCompanyEl.textContent = companyText;

      if (modalBrandEl) modalBrandEl.textContent = activeBrand;
      if (modalPlaysEl) modalPlaysEl.textContent = playsText;
      if (modalAirtimeEl) modalAirtimeEl.textContent = airtimeText;
      if (modalCompanyEl) modalCompanyEl.textContent = companyText;

      // Atualiza data de emissão e ID de documento dinâmico
      const now = new Date();
      const dateStr = now.toLocaleDateString('pt-PT');
      const docIdSuffix = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
      const modalDocIdEl = document.getElementById('modal-cert-doc-id');
      const certDocIdEl = document.getElementById('cert-doc-id');
      const modalDateEl = document.getElementById('modal-cert-issue-date');
      const certDateEl = document.getElementById('cert-issue-date');
      if (modalDocIdEl) modalDocIdEl.textContent = docIdSuffix;
      if (certDocIdEl) certDocIdEl.textContent = docIdSuffix;
      if (modalDateEl) modalDateEl.textContent = dateStr;
      if (certDateEl) certDateEl.textContent = dateStr;

      // Agrega por Parceiro e Conteúdo para uma página de certificado A4 limpa e executiva
      const aggregatedCert = {};
      targetCertPop.forEach((r) => {
        const key = `${r.partner || 'Geral'}|||${r.mediaTitle}`;
        if (!aggregatedCert[key]) {
          aggregatedCert[key] = {
            partner: r.partner || 'Geral',
            mediaTitle: r.mediaTitle,
            contractedSovPct: r.contractedSovPct || 25,
            playCount: 0,
            totalDurationMs: 0,
          };
        }
        aggregatedCert[key].playCount += r.playCount || 0;
        aggregatedCert[key].totalDurationMs += r.totalDurationMs || 0;
      });

      let certTableHtml = `
        <table class="w-full text-left border-collapse text-xs mt-2 border border-gray-300">
          <thead>
            <tr class="bg-gray-100 border-b border-gray-300 font-mono text-[10px] uppercase">
              <th class="p-2 border-r border-gray-300">Parceiro Comercial</th>
              <th class="p-2 border-r border-gray-300">Campanha / Conteúdo</th>
              <th class="p-2 border-r border-gray-300 text-center">SoV Contratado</th>
              <th class="p-2 border-r border-gray-300 text-center">SoV Entregue</th>
              <th class="p-2 border-r border-gray-300 text-right">Total Plays</th>
              <th class="p-2 text-right">Tempo no Ar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
      `;
      const certList = Object.values(aggregatedCert);
      if (certList.length === 0) {
        certTableHtml += `
          <tr>
            <td colspan="6" class="p-4 text-center text-gray-500 font-mono">
              Sem dados de exibição comercial para os filtros selecionados.
            </td>
          </tr>
        `;
      } else {
        certList.forEach((r) => {
          const actualSov = certTotalDurationMs > 0 ? ((r.totalDurationMs / certTotalDurationMs) * 100).toFixed(1) : '0.0';
          certTableHtml += `
            <tr>
              <td class="p-2 font-bold border-r border-gray-300">${r.partner}</td>
              <td class="p-2 border-r border-gray-300">${r.mediaTitle}</td>
              <td class="p-2 border-r border-gray-300 text-center font-mono">${r.contractedSovPct}%</td>
              <td class="p-2 border-r border-gray-300 text-center font-mono font-bold">${actualSov}%</td>
              <td class="p-2 border-r border-gray-300 text-right font-mono font-bold">${r.playCount}</td>
              <td class="p-2 text-right font-mono text-gray-800">${formatDuration(r.totalDurationMs)}</td>
            </tr>
          `;
        });
      }
      certTableHtml += `</tbody></table>`;

      if (certTableEl) certTableEl.innerHTML = certTableHtml;
      if (modalTableEl) modalTableEl.innerHTML = certTableHtml;

      if (certTableEl) certTableEl.innerHTML = certTableHtml;
      if (modalTableEl) modalTableEl.innerHTML = certTableHtml;
    }

    function downloadCsv(filename, rows) {
      const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + rows.map((e) => e.join(';')).join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Exportação 1: Detalhe Forense de Proof of Play
    document.getElementById('btn-export-pop-csv')?.addEventListener('click', () => {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const rows = [
        ['Data_Hora_ISO', 'Insignia', 'Loja', 'Zona', 'Terminal_Hardware', 'Parceiro_Comercial', 'Campanha_Conteudo', 'Prioridade', 'Modo_Loop', 'Duracao_Segundos', 'Hash_Forense_SHA256'],
        ...(latestState.popAuditLogs || [])
          .filter((l) => !l.brand || l.brand === activeBrand)
          .map((l) => [
            l.timestamp,
            l.brand,
            l.storeName || 'Loja Principal',
            l.zone || 'ENTRANCE_LEDWALL',
            l.deviceName || 'Box X98 Plus',
            l.partner || 'Campanha Geral',
            `"${(l.mediaTitle || '').replace(/"/g, '""')}"`,
            l.priority,
            l.schedulingMode || 'FIXED_SLOTS',
            (l.durationMs / 1000).toFixed(1),
            l.sha256 || 'VERIFICADO',
          ]),
      ];
      downloadCsv(`invision_nexus_${activeBrand.toLowerCase()}_proof_of_play_audit.csv`, rows);
    });

    // Exportação 2: Resumo Comercial de Cumprimento de Share of Voice
    document.getElementById('btn-export-sov-csv')?.addEventListener('click', () => {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const allPop = (latestState.popRecords || []).filter((r) => !r.brand || r.brand === activeBrand);
      const totalDurationMs = allPop.reduce((acc, r) => acc + (r.totalDurationMs || 0), 0);

      const rows = [
        ['Insignia', 'Parceiro_Comercial', 'Campanha_Conteudo', 'Loja', 'Zona', 'SoV_Contratado_Pct', 'SoV_Entregue_Pct', 'Cumprimento_SLA_Pct', 'Total_Plays', 'Tempo_Ar_Segundos', 'Estado_Comercial'],
        ...allPop.map((r) => {
          const contracted = r.contractedSovPct || (r.priority === 'EXCLUSIVA' ? 50 : 25);
          const actualSov = totalDurationMs > 0 ? ((r.totalDurationMs / totalDurationMs) * 100).toFixed(1) : '0.0';
          const compliance = Number(contracted) > 0 ? ((Number(actualSov) / Number(contracted)) * 100).toFixed(1) : '100.0';
          const status = Number(compliance) >= 95 ? 'APROVADO_FATURACAO' : Number(compliance) >= 85 ? 'EM_CURSO' : 'EM_DEFICE';
          return [
            r.brand,
            r.partner || 'Campanha Geral',
            `"${(r.mediaTitle || '').replace(/"/g, '""')}"`,
            r.storeName || 'Loja Principal',
            r.zone || 'ENTRANCE_LEDWALL',
            String(contracted),
            actualSov,
            compliance,
            String(r.playCount),
            (r.totalDurationMs / 1000).toFixed(1),
            status,
          ];
        }),
      ];
      downloadCsv(`invision_nexus_${activeBrand.toLowerCase()}_share_of_voice_summary.csv`, rows);
    });

    // Emissão e Impressão Isolada do Certificado Oficial A4 (Zero Leaks de Layout)
    function printOfficialCertificate() {
      const paperEl = document.getElementById('modal-cert-paper');
      if (!paperEl) {
        window.print();
        return;
      }

      let printFrame = document.getElementById('cert-print-iframe');
      if (printFrame) {
        printFrame.remove();
      }

      printFrame = document.createElement('iframe');
      printFrame.id = 'cert-print-iframe';
      printFrame.name = 'cert-print-iframe';
      printFrame.style.position = 'fixed';
      printFrame.style.right = '0';
      printFrame.style.bottom = '0';
      printFrame.style.width = '0';
      printFrame.style.height = '0';
      printFrame.style.border = '0';
      printFrame.style.margin = '0';
      printFrame.style.padding = '0';
      document.body.appendChild(printFrame);

      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const docTitle = `Certificado_Oficial_Proof_of_Play_${activeBrand}`;

      const headStyles = Array.from(document.querySelectorAll('style, link[rel="stylesheet"]'))
        .map((el) => el.outerHTML)
        .join('\n');

      const frameDoc = printFrame.contentWindow.document;
      frameDoc.open();
      frameDoc.write(`
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <title>${docTitle}</title>
  ${headStyles}
  <style>
    @page {
      size: A4 portrait;
      margin: 12mm 15mm;
    }
    * {
      box-sizing: border-box !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    html, body {
      background: #ffffff !important;
      color: #000000 !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
      font-size: 11px !important;
      line-height: 1.4 !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      height: auto !important;
      overflow: visible !important;
    }
    #modal-cert-paper {
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      background: #ffffff !important;
      color: #000000 !important;
    }
    table {
      width: 100% !important;
      border-collapse: collapse !important;
      font-size: 10px !important;
      margin-top: 6px !important;
      margin-bottom: 12px !important;
    }
    th, td {
      border: 1px solid #cbd5e1 !important;
      padding: 6px 8px !important;
    }
    th {
      background-color: #f1f5f9 !important;
      font-weight: 700 !important;
      color: #334155 !important;
      text-transform: uppercase !important;
      font-size: 9px !important;
    }
  </style>
</head>
<body>
  <div style="width: 100%;">
    ${paperEl.outerHTML}
  </div>
</body>
</html>
      `);
      frameDoc.close();

      setTimeout(() => {
        try {
          printFrame.contentWindow.focus();
          printFrame.contentWindow.print();
        } catch (e) {
          console.warn('Iframe print bloqueado pelo navegador, a usar fallback nativo:', e);
          window.print();
        }
      }, 250);
    }

    // Abertura e Controlo do Modal de Certificado de Auditoria
    const certModal = document.getElementById('certificate-modal');
    document.getElementById('btn-print-certificate')?.addEventListener('click', () => {
      certModal?.classList.remove('hidden');
    });
    document.getElementById('btn-modal-close')?.addEventListener('click', () => {
      certModal?.classList.add('hidden');
    });
    certModal?.addEventListener('click', (e) => {
      if (e.target === certModal) {
        certModal.classList.add('hidden');
      }
    });
    document.getElementById('btn-modal-trigger-print')?.addEventListener('click', () => {
      printOfficialCertificate();
    });

    // Modal de Confirmação de Purga de Telemetria (PoP & Interatividade)
    const purgeModal = document.getElementById('purge-confirm-modal');
    const purgeBrandText = document.getElementById('purge-brand-text');
    const purgeFeedbackMsg = document.getElementById('purge-feedback-msg');
    const btnConfirmPurge = document.getElementById('btn-confirm-purge-execute');

    function updatePurgeModalBrand() {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      if (purgeBrandText) purgeBrandText.textContent = activeBrand;
      if (purgeFeedbackMsg) {
        purgeFeedbackMsg.classList.add('hidden');
        purgeFeedbackMsg.textContent = '';
      }
      const storage = latestState.storageMetrics || {};
      const purgeSizeEl = document.getElementById('purge-modal-size');
      const purgeRecordsEl = document.getElementById('purge-modal-records');
      if (purgeSizeEl) {
        purgeSizeEl.textContent = storage.stateFileSizeFormatted || '19.4 KB';
      }
      if (purgeRecordsEl) {
        const totalRecs =
          storage.totalTelemetryRecords !== undefined
            ? storage.totalTelemetryRecords
            : (latestState.popRecords || []).length + (latestState.popAuditLogs || []).length;
        purgeRecordsEl.textContent = `${totalRecs.toLocaleString('pt-PT')} registos`;
      }
    }

    document.getElementById('btn-open-purge-modal')?.addEventListener('click', () => {
      updatePurgeModalBrand();
      purgeModal?.classList.remove('hidden');
    });

    document.getElementById('btn-close-purge-modal')?.addEventListener('click', () => {
      purgeModal?.classList.add('hidden');
    });

    document.getElementById('btn-cancel-purge')?.addEventListener('click', () => {
      purgeModal?.classList.add('hidden');
    });

    purgeModal?.addEventListener('click', (e) => {
      if (e.target === purgeModal) {
        purgeModal.classList.add('hidden');
      }
    });

    btnConfirmPurge?.addEventListener('click', async () => {
      const activeBrand = localStorage.getItem('invision_brand') || 'FNAC';
      const activeRole = localStorage.getItem('invision_role') || 'GLOBAL_ADMIN';
      const selectedScopeEl = document.querySelector('input[name="purge-scope"]:checked');
      const scope = selectedScopeEl ? selectedScopeEl.value : 'ACTIVE_BRAND';

      btnConfirmPurge.disabled = true;
      btnConfirmPurge.innerHTML = '<span>⏳</span> A purgar dados...';

      try {
        const res = await fetch(`${API_BASE}/api/v1/live/telemetry/purge`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            scope,
            brand: activeBrand,
            actor: localStorage.getItem('invision_auth_user') || 'Admin (Break-Glass)',
            role: activeRole,
          }),
        });

        if (res.ok) {
          const data = await res.json();
          if (purgeFeedbackMsg) {
            purgeFeedbackMsg.className = 'p-3 rounded-lg text-xs font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
            purgeFeedbackMsg.textContent = `✔ ${data.message || 'Telemetria purgada com sucesso.'}`;
            purgeFeedbackMsg.classList.remove('hidden');
          }
          await refreshTelemetryPage();
          setTimeout(() => {
            purgeModal?.classList.add('hidden');
            btnConfirmPurge.disabled = false;
            btnConfirmPurge.innerHTML = '<span>🗑️</span> Confirmar e Purgar Dados';
          }, 1200);
        } else {
          throw new Error('Falha na resposta do servidor');
        }
      } catch (err) {
        if (purgeFeedbackMsg) {
          purgeFeedbackMsg.className = 'p-3 rounded-lg text-xs font-mono bg-rose-500/20 text-rose-300 border border-rose-500/30';
          purgeFeedbackMsg.textContent = `❌ Erro ao purgar telemetria: ${err.message || 'Falha de rede'}`;
          purgeFeedbackMsg.classList.remove('hidden');
        }
        btnConfirmPurge.disabled = false;
        btnConfirmPurge.innerHTML = '<span>🗑️</span> Confirmar e Purgar Dados';
      }
    });

    // Alteração da Política de Auditoria de Telemetria (Governance & Data Minimization)
    document.getElementById('select-pop-policy')?.addEventListener('change', async (e) => {
      const newPolicy = e.target.value;
      const select = e.target;
      select.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/api/v1/live/telemetry/policy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            policy: newPolicy,
            actor: localStorage.getItem('invision_auth_user') || 'Admin (Governance)',
            role: localStorage.getItem('invision_role') || 'GLOBAL_ADMIN',
          }),
        });
        if (res.ok) {
          const data = await res.json();
          latestState = data.state || latestState;
          latestState.telemetryAuditPolicy = data.policy || newPolicy;
          syncPolicyDropdown();
          renderCommercialTelemetry();
        }
      } catch (err) {
        console.error('Falha ao atualizar política de auditoria PoP:', err);
      } finally {
        select.disabled = false;
      }
    });

    // Filtros de seleção
    document.getElementById('filter-store')?.addEventListener('change', (e) => {
      selectedStore = e.target.value;
      renderCommercialTelemetry();
    });

    document.getElementById('filter-partner')?.addEventListener('change', (e) => {
      selectedPartner = e.target.value;
      renderCommercialTelemetry();
    });

    document.getElementById('filter-period')?.addEventListener('change', (e) => {
      selectedPeriod = e.target.value;
      renderCommercialTelemetry();
    });

    document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
      selectedStore = 'ALL';
      selectedPartner = 'RETAIL_MEDIA_ONLY';
      selectedPeriod = 'REALTIME';
      const storeEl = document.getElementById('filter-store');
      const partnerEl = document.getElementById('filter-partner');
      const periodEl = document.getElementById('filter-period');
      if (storeEl) storeEl.value = 'ALL';
      if (partnerEl) partnerEl.value = 'RETAIL_MEDIA_ONLY';
      if (periodEl) periodEl.value = 'REALTIME';
      renderCommercialTelemetry();
    });

    // Reage ao alternador de insígnia (FNAC vs DARTY)
    window.addEventListener('invision:brand-change', () => {
      populateStoreDropdown();
      renderCommercialTelemetry();
      updatePurgeModalBrand();
    });

    refreshTelemetryPage();
    setInterval(refreshTelemetryPage, 2500);
  </script>
</DashboardLayout>
