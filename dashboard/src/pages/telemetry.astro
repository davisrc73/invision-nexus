---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Telemetria Comercial & Proof of Play (Auditoria de SoV)" activeNav="telemetry">
  <!-- CONTEÚDO OPERACIONAL / INTERATIVO DA PÁGINA (OCULTO EM MODO DE IMPRESSÃO) -->
  <div id="telemetry-interactive-view" class="print:hidden">
  <!-- TOP ACTIONS & INTRODUÇÃO EXECUTIVA -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap mb-2">
          <span class="text-[11px] font-mono uppercase px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold whitespace-nowrap">
            Auditoria Comercial & Proof of Play (PoP)
          </span>
          <span class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 whitespace-nowrap">
            Conformidade SLA & Faturação de Marcas
          </span>
          <span id="telemetry-brand-badge" class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-500/40 whitespace-nowrap">
            Marca Ativa: FNAC
          </span>
        </div>
        <h3 class="text-xl font-bold text-white tracking-tight">
          Telemetria, Proof of Play & Share of Voice (SoV)
        </h3>
        <p class="text-xs text-slate-300 mt-1 max-w-2xl leading-relaxed">
          Registo criptograficamente auditável de exibições concluídas nos ecrãs de loja para prestação de contas, auditoria de parceiros comerciais (Samsung, Apple, Sony, Dyson, LG, Philips, etc.) e faturação publicitária.
        </p>
      </div>

      <!-- POLÍTICA DE AUDITORIA & BOTÕES DE AÇÃO ORGANIZADOS EM 2 NÍVEIS -->
      <div class="flex flex-col sm:items-end justify-center gap-2.5 shrink-0">
        <!-- NÍVEL 1: SELETOR DE GOVERNANCE: POLÍTICA DE AUDITORIA POP -->
        <div class="flex items-center gap-2 bg-slate-950 border border-slate-700/80 rounded-lg px-3 py-1.5 shadow-inner">
          <span class="text-[10px] font-mono text-slate-300 uppercase font-bold flex items-center gap-1.5 shrink-0">
            <span id="pop-policy-dot" class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            Política PoP:
          </span>
          <select
            id="select-pop-policy"
            class="bg-slate-900 border border-slate-700 rounded px-2.5 py-1 text-white font-mono text-xs focus:border-[#E1A924] outline-none font-bold cursor-pointer"
            title="Definir política de recolha e auditoria de Proof of Play"
          >
            <option value="RETAIL_MEDIA_ONLY">💎 Retail Media (Fornecedores SLA • ~75% Poupança)</option>
            <option value="FULL_AUDIT">🔍 Auditoria Total (100% dos Conteúdos)</option>
            <option value="PAUSED">⏸️ Telemetria Pausada (Manutenção)</option>
          </select>
        </div>

        <!-- NÍVEL 2: BOTÕES DE AÇÃO (EXPORTAÇÕES, CERTIFICADO E PURGA) -->
        <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
          <button
            type="button"
            id="btn-export-pop-csv"
            class="px-3 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-xs shadow transition flex items-center gap-1.5 whitespace-nowrap"
            title="Exportar dados forenses detalhados de Proof of Play para Excel/CSV"
          >
            <span>⬇</span> Exportar PoP (CSV)
          </button>
          <button
            type="button"
            id="btn-export-sov-csv"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs border border-slate-700 transition flex items-center gap-1.5 whitespace-nowrap"
            title="Exportar resumo de cumprimento de Share of Voice por parceiro"
          >
            <span>📊</span> Exportar SoV (CSV)
          </button>
          <button
            type="button"
            id="btn-print-certificate"
            class="px-3.5 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-md shadow-sky-600/30 transition flex items-center gap-1.5 shrink-0 whitespace-nowrap"
            title="Abrir Pré-visualização do Certificado de Auditoria PoP & Imprimir em PDF"
          >
            <span>🖨️</span> Certificado Oficial PDF
          </button>
          <button
            type="button"
            id="btn-open-purge-modal"
            class="px-3 py-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 font-semibold text-xs border border-rose-500/30 transition flex items-center gap-1.5 shrink-0 whitespace-nowrap"
            title="Purgar dados de Proof of Play e telemetria (libertar espaço e repor contadores)"
          >
            <span>🗑️</span> Purgar Telemetria
          </button>
        </div>
      </div>
    </div>

    <!-- BARRA DE FILTROS EXECUTIVOS -->
    <div class="mt-5 pt-4 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
      <div>
        <label class="block text-[11px] font-mono text-slate-400 uppercase mb-1">Filtrar por Loja:</label>
        <select
          id="filter-store"
          class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-white font-mono text-xs focus:border-[#E1A924] outline-none"
        >
          <option value="ALL">Todas as Lojas</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-mono text-slate-400 uppercase mb-1">Filtrar por Parceiro Comercial:</label>
        <select
          id="filter-partner"
          class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-white font-mono text-xs focus:border-[#E1A924] outline-none"
        >
          <option value="RETAIL_MEDIA_ONLY" selected>💎 Apenas Retail Media (Parceiros Comerciais)</option>
          <option value="ALL">Todos os Registos (Inclui Geral/Institucional)</option>
          <option value="Samsung">Samsung</option>
          <option value="Apple">Apple</option>
          <option value="Sony">Sony</option>
          <option value="LG">LG</option>
          <option value="Dyson">Dyson</option>
          <option value="Philips">Philips</option>
          <option value="Whirlpool">Whirlpool</option>
          <option value="DeLonghi">DeLonghi</option>
          <option value="NON_COMMERCIAL">Institucional / FNAC Crédito / Fallback</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-mono text-slate-400 uppercase mb-1">Período de Análise:</label>
        <select
          id="filter-period"
          class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-white font-mono text-xs focus:border-[#E1A924] outline-none"
        >
          <option value="REALTIME">Tempo Real / Hoje</option>
          <option value="LAST_24H">Últimas 24 Horas</option>
          <option value="LAST_7D">Últimos 7 Dias</option>
          <option value="MONTH">Mês de Faturação Atual</option>
        </select>
      </div>
      <div class="flex items-end">
        <button
          type="button"
          id="btn-reset-filters"
          class="w-full px-3 py-1.5 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800 text-xs font-semibold transition"
        >
          ↻ Repor Filtros
        </button>
      </div>
    </div>
  </div>

  <!-- 5 CARTÕES DE KPIS COMERCIAIS & STORAGE -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
          <span class="font-mono uppercase">Total Exibições</span>
          <span class="text-emerald-400">● Auditado</span>
        </div>
        <div class="text-2xl font-black text-white font-mono" id="kpi-total-plays">0</div>
      </div>
      <p class="text-[11px] text-slate-400 mt-1">Concluídas nos ecrãs de loja</p>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
          <span class="font-mono uppercase">Tempo no Ar</span>
          <span class="text-sky-400">⏱️ Emissão</span>
        </div>
        <div class="text-2xl font-black text-sky-300 font-mono" id="kpi-total-airtime">0h 0m 0s</div>
      </div>
      <p class="text-[11px] text-slate-400 mt-1">Tempo efetivo nas bancadas</p>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
          <span class="font-mono uppercase">Cumprimento SoV</span>
          <span class="text-amber-400 font-bold" id="kpi-sov-status">● CONFORME</span>
        </div>
        <div class="text-2xl font-black text-emerald-400 font-mono" id="kpi-avg-sov">100.0%</div>
      </div>
      <p class="text-[11px] text-slate-400 mt-1">SoV real vs contratado</p>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
          <span class="font-mono uppercase">Parceiro Líder</span>
          <span class="text-purple-400">👑 Top Airtime</span>
        </div>
        <div class="text-base font-bold text-white truncate mt-1" id="kpi-top-partner">-</div>
      </div>
      <p class="text-[11px] text-slate-400 mt-1" id="kpi-top-partner-stats">0 plays • 0% do ar</p>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
          <span class="font-mono uppercase">Pegada BD & Storage</span>
          <span class="text-emerald-400 font-bold text-[10px] font-mono" id="kpi-storage-badge">● OTIMIZADO</span>
        </div>
        <div class="text-2xl font-black text-amber-300 font-mono" id="kpi-storage-size">19.4 KB</div>
      </div>
      <div class="mt-1">
        <p class="text-[11px] text-slate-400 flex items-center justify-between">
          <span id="kpi-storage-records">0 registos</span>
          <span class="font-mono text-emerald-400 font-semibold text-[10px]" id="kpi-policy-badge">💎 RETAIL MEDIA</span>
        </p>
        <p class="text-[10px] text-slate-500 font-mono mt-0.5" id="kpi-storage-estimate">~75% poupado em disco</p>
      </div>
    </div>
  </div>

  <!-- SECÇÃO 1: MATRIZ DE CUMPRIMENTO DE SHARE OF VOICE (SOV COMERCIAL) -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-amber-300">
          1. Matriz de Cumprimento de Share of Voice (SoV Contratado vs SoV Real Entregue)
        </h4>
        <p class="text-xs text-slate-400 mt-0.5">
          Auditoria comercial de espaço de ecrã para efeitos de faturação publicitária e cumprimento de SLAs acordados com as marcas parceiras.
        </p>
      </div>
      <span class="px-2.5 py-1 rounded bg-slate-950 border border-slate-800 text-[11px] font-mono text-slate-300">
        Algoritmo: <strong class="text-white">Weighted Round-Robin (Dynamic SoV)</strong>
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-800 text-slate-400 uppercase text-[11px] font-mono">
            <th class="py-3 px-3">Parceiro / Marca</th>
            <th class="py-3 px-3">Campanha / Conteúdo</th>
            <th class="py-3 px-3">Loja / Zona</th>
            <th class="py-3 px-3 text-center">SoV Contratado</th>
            <th class="py-3 px-3 text-center">SoV Entregue</th>
            <th class="py-3 px-3 text-center min-w-[140px]">Conformidade SLA</th>
            <th class="py-3 px-3 text-right">Total Plays</th>
            <th class="py-3 px-3 text-right">Tempo no Ar</th>
            <th class="py-3 px-3 text-center">Estado Comercial</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/70 text-slate-200" id="sov-matrix-body">
          <tr>
            <td colspan="9" class="py-6 px-3 text-slate-400 text-center">
              A calcular auditoria comercial de Share of Voice...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECÇÃO 2: REGISTO CRONOLÓGICO DE PROOF OF PLAY (FITA FORENSE AUDITÁVEL) -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-emerald-400">
          2. Fita Forense de Proof of Play (Últimas Exibições Concluídas e Verificadas)
        </h4>
        <p class="text-xs text-slate-400 mt-0.5">
          Cada linha representa a conclusão bem-sucedida de um vídeo/imagem num ecrã físico, com registo de data/hora, terminal, rácio e assinatura de integridade.
        </p>
      </div>
      <span class="px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-400">
        ● Transmissão Contínua (Buffer Local)
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-800 text-slate-400 uppercase text-[11px] font-mono">
            <th class="py-3 px-3">Data / Hora</th>
            <th class="py-3 px-3">Loja</th>
            <th class="py-3 px-3">Terminal (Box)</th>
            <th class="py-3 px-3">Parceiro</th>
            <th class="py-3 px-3">Conteúdo Exibido</th>
            <th class="py-3 px-3">Prioridade</th>
            <th class="py-3 px-3 text-right">Duração</th>
            <th class="py-3 px-3 text-center">Hash Forense</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/70 text-slate-200" id="pop-log-body">
          <tr>
            <td colspan="8" class="py-6 px-3 text-slate-400 text-center">
              A aguardar eventos de Proof of Play em tempo real...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECÇÃO 3: ENVOLVIMENTO EM BANCADA (TOUCH WAKE & TV DEMO) -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-sky-300">
          3. Métricas de Interatividade em Bancada (Touch Wake & TV Demo)
        </h4>
        <p class="text-xs text-slate-400 mt-0.5">
          Mede o interesse do cliente ao tocar nos smartphones/portáteis em exposição (<code class="text-sky-300">IDLE_SCREENSAVER</code>) ou ao navegar no catálogo de TVs (<code class="text-sky-300">TV_DEMO</code>).
        </p>
      </div>
    </div>
    <div id="interactions-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs"></div>
  </div>
  </div><!-- FIM #telemetry-interactive-view -->

  <!-- ===================================================================== -->
  <!-- MODAL DE PRÉ-VISUALIZAÇÃO DO CERTIFICADO OFICIAL DE AUDITORIA POP     -->
  <!-- ===================================================================== -->
  <div
    id="certificate-modal"
    class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden no-print print:hidden"
  >
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-4xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden">
      <!-- Top Modal Header -->
      <div class="p-4 px-6 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">🖨️</span>
          <div>
            <h3 class="text-sm font-bold text-white">Certificado Oficial de Exibição Publicitária (Proof of Play)</h3>
            <p class="text-[11px] text-slate-400">Documento executivo de prestação de contas aos parceiros comerciais e faturação SLA</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-modal-trigger-print"
            class="px-3.5 py-1.5 rounded-lg bg-[#E1A924] hover:bg-amber-400 text-black font-bold text-xs shadow transition flex items-center gap-1.5"
          >
            <span>🖨️</span> Imprimir / Guardar em PDF
          </button>
          <button
            type="button"
            id="btn-modal-close"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition"
          >
            ✕ Fechar
          </button>
        </div>
      </div>

      <!-- Scrollable Certificate Paper Preview (Light A4 sheet inside dark UI) -->
      <div class="p-6 overflow-y-auto bg-slate-950/80 flex justify-center">
        <div id="modal-cert-paper" class="bg-white text-black p-8 rounded-lg shadow-2xl max-w-3xl w-full text-xs font-sans border border-slate-200">
          <div class="border-b-2 border-black pb-4 mb-5 flex justify-between items-end">
            <div>
              <h1 class="text-xl font-black uppercase tracking-wider text-black" id="modal-cert-company-title">FNAC DARTY GROUP</h1>
              <p class="text-[10px] font-bold text-gray-700 uppercase">INVISION NEXUS • PLATAFORMA CENTRAL DE AUDITORIA DE DIGITAL SIGNAGE</p>
            </div>
            <div class="text-right text-[11px]">
              <p><strong>Nº DOCUMENTO:</strong> POP-<span id="modal-cert-doc-id">2026-1116</span></p>
              <p><strong>DATA DE EMISSÃO:</strong> <span id="modal-cert-issue-date">16/11/2026</span></p>
            </div>
          </div>

          <div class="mb-5">
            <h2 class="text-base font-bold uppercase mb-1 text-black">Certificado Oficial de Exibição Publicitária (Proof of Play)</h2>
            <p class="text-[11px] text-gray-600 leading-relaxed">
              Certifica-se formalmente que as campanhas detalhadas abaixo foram reproduzidas na rede de lojas e ecrãs digitais do Grupo, com validação criptográfica de integridade de ficheiros e monitorização contínua de conformidade de Share of Voice (SoV).
            </p>
          </div>

          <div class="grid grid-cols-3 gap-3 p-3 bg-gray-50 border border-gray-300 rounded mb-5 text-xs">
            <div>
              <p class="text-gray-500 uppercase font-mono text-[9px]">Insígnia Auditada:</p>
              <p class="font-bold text-sm text-black" id="modal-cert-brand-name">FNAC</p>
            </div>
            <div>
              <p class="text-gray-500 uppercase font-mono text-[9px]">Total de Exibições Auditadas:</p>
              <p class="font-bold text-sm text-black" id="modal-cert-total-plays">0 Plays</p>
            </div>
            <div>
              <p class="text-gray-500 uppercase font-mono text-[9px]">Tempo Total em Emissão:</p>
              <p class="font-bold text-sm text-black" id="modal-cert-total-airtime">0h</p>
            </div>
          </div>

          <div class="mb-6">
            <h3 class="text-xs font-bold uppercase mb-2 text-black">Resumo de Cumprimento por Marca Parceira</h3>
            <div id="modal-cert-table-container"></div>
          </div>

          <div class="grid grid-cols-2 gap-8 pt-8 border-t border-gray-300 text-[11px] text-center text-black">
            <div>
              <div class="border-b border-black mb-1 pb-6"></div>
              <p class="font-bold">O Diretor de Operações de Loja</p>
              <p class="text-[9px] text-gray-500">FNAC DARTY PORTUGAL / FRANÇA</p>
            </div>
            <div>
              <div class="border-b border-black mb-1 pb-6"></div>
              <p class="font-bold">O Responsável de Auditoria Multimédia</p>
              <p class="text-[9px] text-gray-500">INVISION NEXUS CENTRAL GOVERNANCE</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL DE CONFIRMAÇÃO DE PURGA DE TELEMETRIA (POP & INTERAÇÕES)       -->
  <!-- ===================================================================== -->
  <div
    id="purge-confirm-modal"
    class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden no-print print:hidden"
  >
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="p-5 px-6 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center text-xl shrink-0">
            ⚠️
          </span>
          <div>
            <h3 class="text-sm font-bold text-white">Confirmar Purga de Telemetria</h3>
            <p class="text-[11px] text-slate-400">Ação Irreversível • Gestão de Armazenamento & Base de Dados</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-purge-modal"
          class="text-slate-400 hover:text-white text-lg p-1 transition"
        >
          ✕
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 space-y-4 text-xs">
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-200 leading-relaxed">
          <p class="font-bold flex items-center gap-1.5 text-rose-300 mb-1">
            <span>🚨</span> Atenção: Os dados serão eliminados definitivamente
          </p>
          <p class="text-[11px] text-slate-300">
            Esta ação elimina os registos acumulados de <strong>Proof of Play (PoP)</strong>, as durações de emissão, a fita forense de auditoria e as contagens de interatividades em bancada, libertando memória e armazenamento no servidor/NAS.
          </p>
        </div>

        <!-- Painel de Espaço Ocupado a Libertar -->
