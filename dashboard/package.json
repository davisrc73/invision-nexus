{
  "name": "@invision-nexus/dashboard",
  "version": "1.0.0",
  "description": "Invision Nexus Central Governance Dashboard (Fnac & Darty)",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=/tmp/astro-config HOME=/tmp astro dev --port 4321 --host",
    "build": "ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=/tmp/astro-config HOME=/tmp astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=/tmp/astro-config HOME=/tmp astro preview --port 4321 --host"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.14.0",
    "tailwindcss": "^3.4.10"
  }
}

