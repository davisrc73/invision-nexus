# Configuração de Ambiente - Invision Nexus (Synology DS220+ / Produção)
NODE_ENV=production
API_PORT=3000
DASHBOARD_PORT=4321
PLAYER_PORT=5173

# PostgreSQL 16 (Porta externa 5434 no NAS para não colidir com o DSM nativo 5432 nem com o BandOS 5433)
POSTGRES_USER=invision_admin
POSTGRES_PASSWORD=invision_secret_2026
POSTGRES_DB=invision_nexus
POSTGRES_PORT=5434

# Redis 7 (Porta externa 6380 no NAS para evitar conflitos com 6379)
REDIS_PORT=6380

# Segurança JWT (Utilizadores & Device Tokens)
JWT_SECRET=fnac_darty_invision_super_secret_jwt_key_change_in_prod

# Políticas de Rede, Heartbeat e Staggered Rollout (4.000 Devices)
HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_TIMEOUT_SEC=180
STAGGER_WINDOW_MAX_SEC=900

